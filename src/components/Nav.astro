---
import Logo from './Logo.astro';
import { Package, BookOpen, PawPrint, Scale } from 'lucide-astro';

interface Props {
  activePage?: 'products' | 'guides' | 'breeds' | 'compare';
}

const { activePage } = Astro.props;

const navLinks = [
  { href: '/products', label: 'Products', key: 'products' },
  { href: '/guides', label: 'Guides', key: 'guides' },
  { href: '/breeds', label: 'Breeds', key: 'breeds' },
];
---

<!-- Floating Pill Navigation -->
<nav class="fixed top-6 left-0 right-0 z-50 flex justify-center px-4 sm:px-6 pointer-events-none">
  <div class="glass-pill px-2 py-2 pr-3 sm:pr-6 rounded-full flex items-center justify-between w-full max-w-5xl pointer-events-auto">
    <div class="flex items-center gap-8 pl-4">
      <a href="/" class="hover:opacity-80 transition-opacity">
        <Logo width={130} height={32} />
      </a>
    </div>
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'nav-link text-sm tracking-wide',
            activePage === link.key ? 'text-brand-700 font-bold' : 'text-ink font-semibold',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="flex items-center gap-2">
      <a href="/products" class="btn-primary bg-ink text-white text-sm font-bold py-3 px-5 sm:px-7 rounded-full transition-transform hidden sm:inline-flex">
        Browse All
      </a>
      <button id="hamburger-btn" class="hamburger-btn md:hidden" aria-label="Open menu" aria-expanded="false">
        <svg class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Drawer -->
<div id="mobile-overlay" class="mobile-drawer-overlay"></div>
<div id="mobile-drawer" class="mobile-drawer">
  <div class="flex items-center justify-between mb-4">
    <span class="font-display font-bold text-ink text-lg">Menu</span>
    <button id="drawer-close" class="hamburger-btn" aria-label="Close menu">
      <svg class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <a href="/products" class="flex items-center gap-2.5"><Package class="w-[18px] h-[18px] opacity-70" /> Products</a>
  <a href="/guides" class="flex items-center gap-2.5"><BookOpen class="w-[18px] h-[18px] opacity-70" /> Guides</a>
  <a href="/breeds" class="flex items-center gap-2.5"><PawPrint class="w-[18px] h-[18px] opacity-70" /> Breeds</a>
  <a href="/compare" class="flex items-center gap-2.5"><Scale class="w-[18px] h-[18px] opacity-70" /> Compare</a>
  <div class="mt-auto pt-6">
    <a href="/products" class="!bg-ink !text-white !rounded-full !justify-center !font-bold">Browse All</a>
  </div>
</div>
