---
/**
 * PawLabs SVG Logo — inline Astro component.
 * Renders at any size via width/height props.
 */
interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 240, height = 60, class: className = '' } = Astro.props;
---

<svg width={width} height={height} viewBox="0 0 240 60" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} aria-label="PawLabs logo">
  <path d="M42 5C30 5 12 8 12 25C12 42 27 55 27 55C27 55 42 42 42 25C42 8 54 5 42 5Z" fill="#1A535C"/>
  <circle cx="20" cy="22" r="3.5" fill="white"/>
  <circle cx="27" cy="15" r="3.5" fill="white"/>
  <circle cx="37" cy="15" r="3.5" fill="white"/>
  <circle cx="44" cy="22" r="3.5" fill="white"/>
  <path d="M32 42C26 42 22 38 22 32C22 28 25 25 32 20C39 25 42 28 42 32C42 38 38 42 32 42ZM32 28C30.5 28 29.5 29 29.5 30.5C29.5 32 30.5 33 32 33C33.5 33 34.5 32 34.5 30.5C34.5 29 33.5 28 32 28Z" fill="white"/>
  <text x="65" y="38" fill="#1A535C" style="font: bold 22px 'Inter', sans-serif; letter-spacing: 0.1em;">PAW</text>
  <text x="125" y="38" fill="#2F3542" style="font: 300 22px 'Inter', sans-serif; letter-spacing: 0.3em;">LABS</text>
</svg>
