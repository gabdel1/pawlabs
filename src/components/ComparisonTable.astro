---
/**
 * ComparisonTable — side-by-side multi-product comparison.
 * Supports 2 to N products. Mobile-optimized with horizontal scroll.
 * Pure Astro — zero JavaScript shipped.
 */

import type { Product, Media } from '../lib/payload';
import { getMediaUrl, CATEGORY_LABELS, PET_TYPE_LABELS } from '../lib/payload';
import { Package } from 'lucide-astro';

interface Props {
  products: Product[];
}

const { products } = Astro.props;

function renderStars(rating: number | undefined): string {
  if (rating == null) return '—';
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5 ? 1 : 0;
  const empty = 5 - full - half;
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
}

// Find best values for highlighting
const prices = products.map(p => p.price).filter((p): p is number => p != null);
const ratings = products.map(p => p.rating).filter((r): r is number => r != null);
const bestPrice = prices.length ? Math.min(...prices) : null;
const bestRating = ratings.length ? Math.max(...ratings) : null;

function priceStyle(price: number | undefined): string {
  if (price == null || bestPrice == null) return 'text-gray-700';
  return price === bestPrice ? 'text-emerald-700 font-semibold bg-emerald-50/60' : 'text-gray-700';
}

function ratingStyle(rating: number | undefined): string {
  if (rating == null || bestRating == null) return 'text-gray-700';
  return rating === bestRating ? 'text-emerald-700 font-semibold bg-emerald-50/60' : 'text-gray-700';
}

// Compute the grid template columns
const colTemplate = `140px repeat(${products.length}, 1fr)`;

type Row = { label: string; values: string[]; styles: string[] };

const rows: Row[] = [
  {
    label: 'Price',
    values: products.map(p => p.price != null ? `$${p.price.toFixed(2)}` : '—'),
    styles: products.map(p => priceStyle(p.price)),
  },
  {
    label: 'Rating',
    values: products.map(p => p.rating != null ? `${renderStars(p.rating)} ${p.rating}/5` : '—'),
    styles: products.map(p => ratingStyle(p.rating)),
  },
  {
    label: 'Category',
    values: products.map(p => p.category ? CATEGORY_LABELS[p.category] ?? p.category : '—'),
    styles: products.map(() => 'text-gray-700'),
  },
  {
    label: 'Pet Type',
    values: products.map(p => p.petType ? PET_TYPE_LABELS[p.petType] ?? p.petType : '—'),
    styles: products.map(() => 'text-gray-700'),
  },
  {
    label: 'Pros',
    values: products.map(p => p.pros?.map(pr => pr.point).join(' · ') || '—'),
    styles: products.map(() => 'text-gray-700'),
  },
  {
    label: 'Cons',
    values: products.map(p => p.cons?.map(c => c.point).join(' · ') || '—'),
    styles: products.map(() => 'text-gray-700'),
  },
];
---

<!-- Mobile: horizontal scroll. Desktop: full table -->
<div class="overflow-x-auto -mx-6 px-6 md:mx-0 md:px-0">
  <div style={`min-width: ${Math.max(600, products.length * 220)}px;`}>
    <!-- Product Header Cards -->
    <div class="grid gap-0 mb-0" style={`grid-template-columns: ${colTemplate};`}>
      <div></div>
      {products.map((product) => {
        const img = getMediaUrl(product.image as Media);
        return (
          <div class="p-4 text-center border-b border-gray-100">
            <div class="w-20 h-20 mx-auto mb-3 bg-gray-50 rounded-xl flex items-center justify-center overflow-hidden">
              {img ? (
                <img src={img} alt={product.name} class="max-w-full max-h-full object-contain rounded-lg" />
              ) : (
                <Package class="w-8 h-8 text-ink opacity-20" />
              )}
            </div>
            <a href={`/products/${product.slug}`} class="text-sm font-bold text-gray-900 hover:text-brand-800 transition-colors">
              {product.name}
            </a>
            {product.price != null && (
              <p class="text-lg font-bold text-gray-900 mt-1">${product.price.toFixed(2)}</p>
            )}
            {product.affiliateUrl && (
              <a
                href={product.affiliateUrl}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="inline-block mt-2 bg-brand-800 hover:bg-brand-900 text-white text-xs font-semibold py-1.5 px-4 rounded-lg transition-colors"
              >
                Buy Now →
              </a>
            )}
          </div>
        );
      })}
    </div>

    <!-- Comparison Rows -->
    <table class="w-full border-collapse">
      <thead class="sr-only">
        <tr>
          <th>Feature</th>
          {products.map(p => <th>{p.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row, i) => (
          <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}>
            <td class="px-4 py-3 text-xs font-semibold text-gray-400 uppercase tracking-wide w-[140px] align-top">
              {row.label}
            </td>
            {row.values.map((val, j) => (
              <td class={`px-4 py-3 text-sm text-center align-top ${row.styles[j]}`}>
                {val}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
