---
/**
 * /compare — Breed comparison hub.
 *
 * Two things live here:
 *  1. An interactive picker — all breed data is embedded at build time as JSON,
 *     and the table is built client-side from ?breeds=slug1,slug2,...
 *  2. An index of published, long-form breed comparison articles.
 */

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import Footer from '../../components/Footer.astro';
import { getBreeds, getComparisons, getMediaUrl, BREED_GROUP_LABELS, SIZE_LABELS, CRITERION_LABELS } from '../../lib/payload';
import type { Breed, Media } from '../../lib/payload';
import { comparisonsListJsonLd } from '../../lib/seo';
import { Scale, ArrowUpRight, Search } from 'lucide-astro';

const breeds = await getBreeds();
const comparisons = await getComparisons();

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compare' },
];

/** Derived criteria — mirrors BreedComparisonTable so the client table matches. */
const CRITERIA = [
  'lowShedding',
  'apartmentFriendly',
  'watchdogAbility',
  'trainability',
  'childFriendly',
  'energyLevel',
  'easyGrooming',
];

function derive(breed: Breed) {
  const t = breed.traits || {};
  const score = (key: keyof NonNullable<Breed['traits']>) => {
    const v = t[key];
    return typeof v === 'number' ? v : null;
  };
  const invert = (v: number | null) => (v == null ? null : 11 - v);

  const adapt = score('adaptability');
  const bark = score('barkingLevel');
  const parts: number[] = [];
  if (adapt != null) parts.push(adapt);
  if (bark != null) parts.push(11 - bark);

  return {
    lowShedding: invert(score('sheddingLevel')),
    apartmentFriendly: parts.length ? Math.round(parts.reduce((a, b) => a + b, 0) / parts.length) : null,
    watchdogAbility: score('watchdogAbility'),
    trainability: score('trainability'),
    childFriendly: score('childFriendly'),
    energyLevel: score('energyLevel'),
    easyGrooming: invert(score('groomingNeeds')),
  };
}

const breedData = breeds.map(b => ({
  name: b.name,
  slug: b.slug,
  group: b.breedGroup ? BREED_GROUP_LABELS[b.breedGroup] ?? b.breedGroup : '',
  size: b.size ? SIZE_LABELS[b.size] ?? b.size : '—',
  weight: b.weightMin && b.weightMax ? `${b.weightMin}-${b.weightMax} lb` : '—',
  lifespan: b.lifeExpectancyMin && b.lifeExpectancyMax ? `${b.lifeExpectancyMin}-${b.lifeExpectancyMax} yrs` : '—',
  image: getMediaUrl(b.image as Media),
  criteria: derive(b),
}));
---

<Layout
  title="Compare Dog Breeds Side-by-Side | PawLabs"
  description="Compare any two dog breeds head-to-head — shedding, energy, trainability, apartment suitability and more, scored out of 10."
  canonicalUrl="/compare"
  jsonLd={[comparisonsListJsonLd(comparisons)]}
>
  <Nav activePage="compare" />

  <div class="pt-32 sm:pt-36">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <main class="min-h-screen bg-surface noise">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

      <!-- Header -->
      <div class="mb-10 reveal">
        <div class="inline-flex items-center gap-2 badge bg-brand-100 text-brand-800 mb-4">
          <Scale class="w-3.5 h-3.5" /> Side-by-Side
        </div>
        <h1 class="display-heading display-fluid-lg text-ink mb-4">Compare Dog Breeds.</h1>
        <p class="text-ink-muted text-base sm:text-lg max-w-2xl text-pretty">
          Pick any two or more breeds and see how they actually differ — shedding, energy, trainability,
          and whether they'll tolerate apartment life. Every score is out of 10.
        </p>
      </div>

      <!-- Picker -->
      <section class="glass-card rounded-3xl p-5 sm:p-8 mb-12 reveal">
        <label for="breed-search" class="block text-sm font-bold text-ink mb-3">Add breeds to compare</label>
        <div class="relative mb-4">
          <Search class="w-4 h-4 text-ink-muted absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" />
          <input
            id="breed-search"
            type="search"
            autocomplete="off"
            placeholder="Search 200+ breeds…"
            class="w-full rounded-full border border-ink/15 bg-white pl-11 pr-4 py-3 text-sm font-medium text-ink focus:border-brand-500 focus:outline-none"
          />
          <div id="breed-suggestions" class="hidden absolute z-20 left-0 right-0 mt-2 max-h-72 overflow-y-auto rounded-2xl border border-ink/10 bg-white shadow-xl"></div>
        </div>

        <div id="selected-breeds" class="flex flex-wrap gap-2 min-h-[2.5rem]">
          <p id="empty-hint" class="text-sm text-ink-muted">No breeds selected yet — search above to begin.</p>
        </div>
      </section>

      <!-- Comparison result -->
      <section id="comparison-output" class="hidden mb-16 reveal"></section>

      <!-- Published comparisons -->
      {comparisons.length > 0 && (
        <section class="mb-16">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8 reveal">
            <div>
              <h2 class="display-heading text-2xl sm:text-3xl text-ink mb-2">In-Depth Comparisons</h2>
              <p class="text-ink-muted text-sm sm:text-base">Long-form head-to-head breakdowns with a final verdict.</p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {comparisons.map((comparison) => {
              const imgUrl = getMediaUrl(comparison.featuredImage as Media);
              const linked = (comparison.breeds || []).filter(b => typeof b !== 'string') as Breed[];
              return (
                <a href={`/compare/${comparison.slug}`} class="card-hover group glass-card rounded-2xl overflow-hidden border-transparent hover:border-brand-200 flex flex-col">
                  <div class="relative aspect-[16/10] bg-brand-50 overflow-hidden">
                    {imgUrl ? (
                      <img src={imgUrl} alt={comparison.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-brand-200/60 to-brand-50 flex items-center justify-center">
                        <Scale class="w-10 h-10 text-brand-700/30" />
                      </div>
                    )}
                  </div>
                  <div class="p-5 flex flex-col flex-1">
                    {linked.length > 0 && (
                      <p class="text-[11px] font-bold uppercase tracking-wide text-brand-700 mb-2">
                        {linked.length} breeds compared
                      </p>
                    )}
                    <h3 class="font-display font-bold text-ink text-base group-hover:text-brand-700 transition-colors mb-2 leading-snug">
                      {comparison.title}
                    </h3>
                    {comparison.summary && (
                      <p class="text-sm text-ink-muted line-clamp-3 mb-4">{comparison.summary}</p>
                    )}
                    <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-bold text-brand-700">
                      Read comparison <ArrowUpRight class="w-4 h-4" />
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <div class="max-w-3xl mx-auto reveal">
        <NewsletterSignup variant="banner" source="compare" />
      </div>
    </div>
  </main>

  <Footer />

  <script is:inline define:vars={{ breedData, CRITERIA, CRITERION_LABELS }}>
    const searchInput = document.getElementById('breed-search');
    const suggestions = document.getElementById('breed-suggestions');
    const selectedWrap = document.getElementById('selected-breeds');
    const emptyHint = document.getElementById('empty-hint');
    const output = document.getElementById('comparison-output');

    const bySlug = new Map(breedData.map(b => [b.slug, b]));
    let selected = [];

    function syncUrl() {
      const url = new URL(window.location.href);
      if (selected.length) {
        url.searchParams.set('breeds', selected.join(','));
      } else {
        url.searchParams.delete('breeds');
      }
      window.history.replaceState({}, '', url);
    }

    function scoreClass(v) {
      if (typeof v !== 'number') return 'score score-low';
      if (v >= 8) return 'score score-top';
      if (v >= 6) return 'score score-good';
      if (v >= 4) return 'score score-mid';
      return 'score score-low';
    }

    function renderChips() {
      selectedWrap.querySelectorAll('[data-chip]').forEach(el => el.remove());
      emptyHint.style.display = selected.length ? 'none' : '';

      selected.forEach(slug => {
        const breed = bySlug.get(slug);
        if (!breed) return;
        const chip = document.createElement('span');
        chip.setAttribute('data-chip', slug);
        chip.className = 'inline-flex items-center gap-2 rounded-full bg-ink text-white pl-3 pr-1.5 py-1.5 text-sm font-bold';
        chip.innerHTML = `<span></span><button type="button" aria-label="Remove" class="w-5 h-5 rounded-full bg-white/20 hover:bg-white/40 leading-none">&times;</button>`;
        chip.querySelector('span').textContent = breed.name;
        chip.querySelector('button').addEventListener('click', () => {
          selected = selected.filter(s => s !== slug);
          renderChips();
          renderTable();
          syncUrl();
        });
        selectedWrap.appendChild(chip);
      });
    }

    function renderTable() {
      if (selected.length < 2) {
        output.className = 'hidden mb-16 reveal';
        output.innerHTML = '';
        return;
      }
      output.className = 'mb-16 reveal';

      const rows = selected.map(s => bySlug.get(s)).filter(Boolean);
      const head = ['Breed', 'Size', 'Weight', 'Life Span', ...CRITERIA.map(c => CRITERION_LABELS[c] || c)];

      const table = document.createElement('div');
      table.className = 'glass-card rounded-3xl p-4 sm:p-6';
      table.innerHTML = `
        <h2 class="display-heading text-xl sm:text-2xl text-ink mb-4">Breed Comparison Table</h2>
        <div class="table-wrap"><table class="breed-table"><thead><tr>${head.map(h => `<th scope="col">${h}</th>`).join('')}</tr></thead><tbody></tbody></table></div>
      `;

      const tbody = table.querySelector('tbody');
      rows.forEach(breed => {
        const tr = document.createElement('tr');
        const cells = [
          `<th scope="row"><a class="breed-link" href="/breeds/${breed.slug}"></a></th>`,
          `<td>${breed.size}</td>`,
          `<td>${breed.weight}</td>`,
          `<td>${breed.lifespan}</td>`,
          ...CRITERIA.map(c => {
            const v = breed.criteria[c];
            return `<td><span class="${scoreClass(v)}">${typeof v === 'number' ? v + '/10' : '—'}</span></td>`;
          }),
        ];
        tr.innerHTML = cells.join('');
        tr.querySelector('.breed-link').textContent = breed.name;
        tbody.appendChild(tr);
      });

      output.innerHTML = '';
      output.appendChild(table);
    }

    function addBreed(slug) {
      if (selected.includes(slug)) return;
      selected.push(slug);
      renderChips();
      renderTable();
      syncUrl();
    }

    function renderSuggestions(query) {
      const q = query.trim().toLowerCase();
      if (!q) {
        suggestions.classList.add('hidden');
        return;
      }
      const matches = breedData
        .filter(b => !selected.includes(b.slug) && b.name.toLowerCase().includes(q))
        .slice(0, 8);

      if (!matches.length) {
        suggestions.classList.add('hidden');
        return;
      }

      suggestions.innerHTML = '';
      matches.forEach(b => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex w-full items-center gap-3 px-4 py-2.5 text-left hover:bg-brand-50 transition-colors';
        btn.innerHTML = `<span class="font-bold text-ink text-sm"></span><span class="text-xs text-ink-muted ml-auto"></span>`;
        btn.querySelector('span').textContent = b.name;
        btn.querySelectorAll('span')[1].textContent = [b.group, b.size].filter(Boolean).join(' · ');
        btn.addEventListener('click', () => {
          addBreed(b.slug);
          searchInput.value = '';
          suggestions.classList.add('hidden');
        });
        suggestions.appendChild(btn);
      });
      suggestions.classList.remove('hidden');
    }

    searchInput.addEventListener('input', e => renderSuggestions(e.target.value));
    searchInput.addEventListener('focus', e => renderSuggestions(e.target.value));
    document.addEventListener('click', e => {
      if (!suggestions.contains(e.target) && e.target !== searchInput) {
        suggestions.classList.add('hidden');
      }
    });

    // Hydrate from ?breeds=
    const initial = new URLSearchParams(window.location.search).get('breeds');
    if (initial) {
      initial.split(',').map(s => s.trim()).filter(s => bySlug.has(s)).forEach(s => {
        if (!selected.includes(s)) selected.push(s);
      });
      renderChips();
      renderTable();
    }
  </script>

  <style>
    .table-wrap { overflow-x: auto; }
    .breed-table {
      width: 100%;
      min-width: 720px;
      border-collapse: separate;
      border-spacing: 0;
    }
    .breed-table thead th {
      background: #eef6f4;
      color: #415861;
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 800;
      padding: 0.8rem 0.7rem;
      border-bottom: 1px solid #d9e4e4;
      white-space: nowrap;
    }
    .breed-table tbody th,
    .breed-table tbody td {
      border-bottom: 1px solid #eef2f2;
      padding: 0.75rem 0.7rem;
      text-align: center;
      font-size: 0.88rem;
      color: #31434a;
    }
    .breed-table tbody th {
      text-align: left;
      font-weight: 700;
      position: sticky;
      left: 0;
      background: #fff;
      z-index: 1;
    }
    .breed-link {
      color: #132a31;
      text-decoration: none;
      border-bottom: 1px dashed #8fb3ab;
    }
    .breed-link:hover { color: #0c4d5f; border-bottom-style: solid; }
    .score {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 3rem;
      border-radius: 999px;
      padding: 0.2rem 0.5rem;
      font-weight: 800;
      font-size: 0.78rem;
    }
    .score-top { background: #e6fff1; color: #0f7a48; }
    .score-good { background: #f0fbff; color: #1a758d; }
    .score-mid { background: #fff7e9; color: #9c6611; }
    .score-low { background: #fff0f0; color: #a23b3b; }
  </style>
</Layout>
