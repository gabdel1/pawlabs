---
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { getProducts, getMediaUrl, CATEGORY_LABELS } from '../../lib/payload';
import type { Product, Media } from '../../lib/payload';
import { comparisonJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const products = await getProducts();
  const paths = [];

  // Generate all pairwise combinations
  for (let i = 0; i < products.length; i++) {
    for (let j = i + 1; j < products.length; j++) {
      const a = products[i];
      const b = products[j];
      paths.push({
        params: { slugs: `${a.slug}-vs-${b.slug}` },
        props: { productA: a, productB: b },
      });
      paths.push({
        params: { slugs: `${b.slug}-vs-${a.slug}` },
        props: { productA: b, productB: a },
      });
    }
  }

  return paths;
}

const { productA, productB } = Astro.props as { productA: Product; productB: Product };

const imgA = getMediaUrl(productA.image as Media);
const imgB = getMediaUrl(productB.image as Media);

// Determine winner for verdict
const ratingA = productA.rating ?? 0;
const ratingB = productB.rating ?? 0;
const winner = ratingA > ratingB ? productA : ratingB > ratingA ? productB : null;

const breadcrumbs = [
  { label: '🐾 Home', href: '/' },
  { label: 'Products', href: '/products' },
  { label: `${productA.name} vs ${productB.name}` },
];
---

<Layout
  title={`${productA.name} vs ${productB.name} - PawLabs Comparison`}
  description={`Head-to-head comparison of ${productA.name} and ${productB.name}. Compare price, rating, features, pros and cons.`}
  canonicalUrl={`/compare/${productA.slug}-vs-${productB.slug}`}
  ogType="article"
  ogImage={imgA || imgB}
  jsonLd={comparisonJsonLd(productA, productB)}
>
  <!-- Sticky Nav -->
  <nav class="bg-white/95 backdrop-blur-md border-b border-gray-100 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/">
        <Logo width={160} height={40} />
      </a>
      <div class="flex items-center gap-6">
        <a href="/products" class="text-ink-light text-sm font-medium hover:text-brand-800 transition-colors">Products</a>
        <a href="/products" class="bg-brand-800 hover:bg-brand-900 text-white text-sm font-semibold py-2 px-5 rounded-xl transition-colors">
          Browse All
        </a>
      </div>
    </div>
  </nav>

  <Breadcrumbs items={breadcrumbs} />

  <main class="min-h-screen bg-surface">
    <div class="max-w-6xl mx-auto px-6 py-10">
      <!-- Comparison Header -->
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-ink mb-3">
          {productA.name} <span class="text-brand-500">vs</span> {productB.name}
        </h1>
        <p class="text-ink-muted">Side-by-side product comparison — which one should you buy?</p>
      </div>

      <!-- Comparison Table -->
      <div class="bg-surface-raised rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <ComparisonTable productA={productA} productB={productB} />
      </div>

      <!-- Pros & Cons Side by Side -->
      <div class="grid md:grid-cols-2 gap-6 mt-8">
        {[productA, productB].map((product) => (
          <div>
            <h3 class="text-lg font-bold text-ink mb-4">{product.name}</h3>
            {product.pros?.length ? (
              <div class="bg-surface-raised rounded-xl border border-gray-100 p-5 mb-4">
                <h4 class="text-sm font-semibold text-emerald-700 mb-3">✓ Pros</h4>
                <ul class="space-y-1.5">
                  {product.pros.map((pro) => (
                    <li class="flex items-start gap-2 text-sm text-ink-light">
                      <span class="text-emerald-500 shrink-0">•</span> {pro.point}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null}
            {product.cons?.length ? (
              <div class="bg-surface-raised rounded-xl border border-gray-100 p-5">
                <h4 class="text-sm font-semibold text-red-700 mb-3">✗ Cons</h4>
                <ul class="space-y-1.5">
                  {product.cons.map((con) => (
                    <li class="flex items-start gap-2 text-sm text-ink-light">
                      <span class="text-red-500 shrink-0">•</span> {con.point}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null}
          </div>
        ))}
      </div>

      <!-- Verdict -->
      <div class="bg-brand-950 rounded-2xl p-8 md:p-10 mt-8 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">
          🏆 Our Verdict
        </h2>
        {winner ? (
          <div>
            <p class="text-teal-200 text-lg mb-4">
              We recommend the <strong class="text-white">{winner.name}</strong> with a rating of {winner.rating}/5.
              {winner.id === productA.id
                ? ` It edges out the ${productB.name} with better overall value.`
                : ` It edges out the ${productA.name} with better overall value.`
              }
            </p>
            {winner.affiliateUrl && (
              <a
                href={winner.affiliateUrl}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="inline-flex items-center justify-center gap-2 bg-white text-brand-800 font-bold py-4 px-10 rounded-2xl text-lg transition-all duration-200 hover:shadow-2xl hover:shadow-white/20 hover:scale-105"
              >
                Get the {winner.name} →
              </a>
            )}
          </div>
        ) : (
          <p class="text-teal-200 text-lg">
            Both products are excellent choices! Check the individual reviews above to see which fits your needs better.
          </p>
        )}
      </div>

      <!-- Links to individual reviews -->
      <div class="grid md:grid-cols-2 gap-4 mt-8">
        {[productA, productB].map((product) => (
          <a href={`/products/${product.slug}`} class="card-hover bg-surface-raised rounded-xl border border-gray-100 p-5 flex items-center gap-4">
            <span class="text-3xl">📖</span>
            <div>
              <p class="font-bold text-ink">{product.name}</p>
              <p class="text-sm text-brand-800">Read Full Review →</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-ink py-10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <Logo width={120} height={30} variant="white" />
      <p class="text-gray-500 text-xs">
        Affiliate Disclosure: We may earn commissions from qualifying purchases.
      </p>
    </div>
  </footer>
</Layout>
