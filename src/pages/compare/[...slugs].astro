---
import Layout from '../../layouts/Layout.astro';
import { getProductBySlug, getMediaUrl, CATEGORY_LABELS, PET_TYPE_LABELS, VERDICT_LABELS } from '../../lib/payload';
import type { Product, Media } from '../../lib/payload';
import { comparisonJsonLd } from '../../lib/seo';

// URL format: /compare/product-slug-1-vs-product-slug-2
const { slugs } = Astro.params;

if (!slugs || !slugs.includes('-vs-')) {
  return new Response('Invalid comparison URL. Use format: /compare/product-a-vs-product-b', { status: 400 });
}

const parts = slugs.split('-vs-');
if (parts.length !== 2) {
  return new Response('Comparison requires exactly two products. Use format: /compare/product-a-vs-product-b', { status: 400 });
}

const [slug1, slug2] = parts;
const [product1, product2] = await Promise.all([
  getProductBySlug(slug1),
  getProductBySlug(slug2),
]);

if (!product1 || !product2) {
  const missing = !product1 ? slug1 : slug2;
  return new Response(`Product not found: ${missing}`, { status: 404 });
}

const products = [product1, product2] as const;

function renderStars(rating: number | undefined): string {
  if (rating == null) return '—';
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5 ? 1 : 0;
  const empty = 5 - full - half;
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
}

function getWinner(val1: number | undefined, val2: number | undefined, higherIsBetter = true): [boolean, boolean] {
  if (val1 == null || val2 == null) return [false, false];
  if (val1 === val2) return [false, false];
  if (higherIsBetter) return [val1 > val2, val2 > val1];
  return [val1 < val2, val2 < val1];
}

const [priceWin1, priceWin2] = getWinner(product1.price, product2.price, false);
const [ratingWin1, ratingWin2] = getWinner(product1.rating, product2.rating, true);

type ComparisonRow = {
  label: string;
  values: [string, string];
  highlights: [boolean, boolean];
};

const rows: ComparisonRow[] = [
  {
    label: 'Price',
    values: [
      product1.price != null ? `$${product1.price.toFixed(2)}` : '—',
      product2.price != null ? `$${product2.price.toFixed(2)}` : '—',
    ],
    highlights: [priceWin1, priceWin2],
  },
  {
    label: 'Rating',
    values: [
      product1.rating != null ? `${renderStars(product1.rating)} ${product1.rating}/5` : '—',
      product2.rating != null ? `${renderStars(product2.rating)} ${product2.rating}/5` : '—',
    ],
    highlights: [ratingWin1, ratingWin2],
  },
  {
    label: 'Category',
    values: [
      product1.category ? CATEGORY_LABELS[product1.category] ?? product1.category : '—',
      product2.category ? CATEGORY_LABELS[product2.category] ?? product2.category : '—',
    ],
    highlights: [false, false],
  },
  {
    label: 'Pet Type',
    values: [
      product1.petType ? PET_TYPE_LABELS[product1.petType] ?? product1.petType : '—',
      product2.petType ? PET_TYPE_LABELS[product2.petType] ?? product2.petType : '—',
    ],
    highlights: [false, false],
  },
  {
    label: 'Pros',
    values: [
      product1.pros?.map(p => p.point).join(', ') || '—',
      product2.pros?.map(p => p.point).join(', ') || '—',
    ],
    highlights: [false, false],
  },
  {
    label: 'Cons',
    values: [
      product1.cons?.map(c => c.point).join(', ') || '—',
      product2.cons?.map(c => c.point).join(', ') || '—',
    ],
    highlights: [false, false],
  },
];

const img1 = getMediaUrl(product1.image as Media);
const img2 = getMediaUrl(product2.image as Media);
---

<Layout
  title={`${product1.name} vs ${product2.name} - PawLabs Comparison`}
  description={`Head-to-head comparison of ${product1.name} and ${product2.name}. Compare price, rating, features, pros and cons.`}
  canonicalUrl={`/compare/${product1.slug}-vs-${product2.slug}`}
  ogType="article"
  ogImage={img1 || img2}
  jsonLd={comparisonJsonLd(product1, product2)}
>
  <main class="min-h-screen bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white border-b border-gray-200 px-6 py-4">
      <div class="max-w-6xl mx-auto flex items-center gap-2 text-sm text-gray-500">
        <a href="/" class="hover:text-indigo-600 transition-colors">🐾 PawLabs</a>
        <span>/</span>
        <span class="text-gray-900 font-medium">Compare</span>
      </div>
    </nav>

    <div class="max-w-6xl mx-auto px-6 py-10">
      <!-- Comparison Header -->
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">
          {product1.name} <span class="text-indigo-500">vs</span> {product2.name}
        </h1>
        <p class="text-gray-500">Side-by-side product comparison</p>
      </div>

      <!-- Product Cards -->
      <div class="grid md:grid-cols-2 gap-6 mb-10">
        {products.map((product, i) => {
          const imgUrl = i === 0 ? img1 : img2;
          return (
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
              <div class="bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center p-8 min-h-[200px]">
                {imgUrl ? (
                  <img src={imgUrl} alt={product.name} class="max-w-full max-h-48 object-contain rounded-lg" />
                ) : (
                  <div class="text-6xl opacity-30">📦</div>
                )}
              </div>
              <div class="p-6 text-center">
                <a href={`/products/${product.slug}`} class="text-xl font-bold text-gray-900 hover:text-indigo-600 transition-colors">
                  {product.name}
                </a>
                {product.rating != null && (
                  <p class="text-amber-500 mt-2">{renderStars(product.rating)} <span class="text-gray-400 text-sm">{product.rating}/5</span></p>
                )}
                {product.price != null && (
                  <p class="text-2xl font-bold text-gray-900 mt-2">${product.price.toFixed(2)}</p>
                )}
                {product.affiliateUrl && (
                  <a
                    href={product.affiliateUrl}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class="inline-block mt-4 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-2.5 px-6 rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-indigo-200"
                  >
                    Buy Now →
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Comparison Table -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-100">
          <h2 class="text-lg font-bold text-gray-900">Detailed Comparison</h2>
        </div>
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-100">
              <th class="text-left px-6 py-3 text-sm font-semibold text-gray-500 w-1/4">Feature</th>
              <th class="text-center px-6 py-3 text-sm font-semibold text-gray-900 w-[37.5%]">{product1.name}</th>
              <th class="text-center px-6 py-3 text-sm font-semibold text-gray-900 w-[37.5%]">{product2.name}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}>
                <td class="px-6 py-4 text-sm font-medium text-gray-500">{row.label}</td>
                <td class={`px-6 py-4 text-sm text-center ${row.highlights[0] ? 'text-emerald-700 font-semibold bg-emerald-50/50' : 'text-gray-700'}`}>
                  {row.values[0]}
                </td>
                <td class={`px-6 py-4 text-sm text-center ${row.highlights[1] ? 'text-emerald-700 font-semibold bg-emerald-50/50' : 'text-gray-700'}`}>
                  {row.values[1]}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Pros & Cons Side by Side -->
      <div class="grid md:grid-cols-2 gap-6 mt-8">
        {products.map((product) => (
          <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4">{product.name}</h3>
            {product.pros?.length ? (
              <div class="bg-white rounded-xl border border-gray-100 p-5 mb-4">
                <h4 class="text-sm font-semibold text-emerald-700 mb-3">✓ Pros</h4>
                <ul class="space-y-1.5">
                  {product.pros.map((pro) => (
                    <li class="flex items-start gap-2 text-sm text-gray-700">
                      <span class="text-emerald-500 shrink-0">•</span> {pro.point}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null}
            {product.cons?.length ? (
              <div class="bg-white rounded-xl border border-gray-100 p-5">
                <h4 class="text-sm font-semibold text-red-700 mb-3">✗ Cons</h4>
                <ul class="space-y-1.5">
                  {product.cons.map((con) => (
                    <li class="flex items-start gap-2 text-sm text-gray-700">
                      <span class="text-red-500 shrink-0">•</span> {con.point}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null}
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>
