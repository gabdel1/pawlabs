---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BreedComparisonTable from '../../components/BreedComparisonTable.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import QuizPromo from '../../components/QuizPromo.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import Footer from '../../components/Footer.astro';
import { getComparisons, getMediaUrl, comparisonBreedIds, comparisonDate } from '../../lib/payload';
import type { Breed, Comparison, Media } from '../../lib/payload';
import { comparisonJsonLd, comparisonFaqJsonLd } from '../../lib/seo';
import { comparisonMetaTitle, comparisonDescription } from '../../lib/meta';
import { isNoindexed } from '../../lib/noindex';
import { withoutRetired } from '../../lib/retired';
import { buildComparisonFaqs } from '../../lib/comparison-faq';
import { EDITORIAL_TEAM } from '../../lib/site';
import { Scale, ArrowUpRight, Calendar } from 'lucide-astro';

export async function getStaticPaths() {
  // Retired articles get no page at all; nginx redirects their URLs to the
  // ranking that covers the same breeds. See src/lib/retired.ts.
  const comparisons = withoutRetired(await getComparisons());

  return comparisons.map((comparison) => {
    const ownBreeds = new Set(comparisonBreedIds(comparison));

    // Most shared breeds first; newest wins a tie.
    const related = comparisons
      .filter((other) => other.slug !== comparison.slug)
      .map((other) => ({
        comparison: other,
        overlap: comparisonBreedIds(other).filter((id) => ownBreeds.has(id)).length,
      }))
      .filter((entry) => entry.overlap > 0)
      .sort(
        (a, b) =>
          b.overlap - a.overlap || comparisonDate(b.comparison) - comparisonDate(a.comparison),
      )
      .slice(0, 3)
      .map((entry) => entry.comparison);

    return {
      params: { slug: comparison.slug },
      props: { comparison, related },
    };
  });
}

const { comparison, related = [] } = Astro.props as { comparison: Comparison; related?: Comparison[] };

const linkedBreeds = (comparison.breeds || []).filter(b => typeof b !== 'string') as Breed[];
const criteria = (comparison.comparisonCriteria || []).map(c => c.criterion).filter(Boolean);
const imageUrl = getMediaUrl(comparison.featuredImage as Media);

// Documents default to "PawLabs Team" — show the editorial team name the byline
// links through to, so the attribution and the bio match.
const bylineAuthor =
  !comparison.author || /^pawlabs( team)?$/i.test(comparison.author.trim())
    ? EDITORIAL_TEAM.name
    : comparison.author;

// FAQs are extracted verbatim from this article's own prose. The page renders
// them visibly below and the FAQPage markup is built from the same array, so
// the schema can never reference text that is not on the page.
const faqs = buildComparisonFaqs(comparison, linkedBreeds);
const faqJsonLd = comparisonFaqJsonLd(faqs, comparison.slug);

// Articles about pairings nobody searches for stay reachable but are kept out
// of search and off the index page. See scripts/compute-noindex.ts.
const noindex = isNoindexed(comparison.slug);

const publishedDate = comparison.publishedDate || comparison.createdAt;
const formattedDate = publishedDate
  ? new Date(publishedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compare', href: '/compare' },
  { label: comparison.title },
];
---

<Layout
  title={comparisonMetaTitle(comparison)}
  description={comparisonDescription(comparison, linkedBreeds)}
  ogTitle={comparison.title}
  canonicalUrl={`/compare/${comparison.slug}`}
  noindex={noindex}
  ogType="article"
  ogImage={imageUrl}
  jsonLd={faqJsonLd
    ? [comparisonJsonLd(comparison, linkedBreeds), faqJsonLd]
    : [comparisonJsonLd(comparison, linkedBreeds)]}
  publishedTime={publishedDate}
  modifiedTime={comparison.updatedAt}
>
  <Nav activePage="compare" />

  <div class="pt-32 sm:pt-36">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <main class="min-h-screen bg-surface noise">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

      <!-- Header -->
      <header class="mb-10 reveal">
        <div class="inline-flex items-center gap-2 badge bg-brand-100 text-brand-800 mb-4">
          <Scale class="w-3.5 h-3.5" /> Breed Comparison
        </div>
        <h1 class="display-heading display-fluid-lg text-ink mb-5 text-balance">{comparison.title}</h1>

        {comparison.summary && (
          <p class="text-ink-muted text-base sm:text-xl leading-relaxed text-pretty mb-6">{comparison.summary}</p>
        )}

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-light font-medium">
          <span>
            By <a href="/about#who-writes-this" class="font-semibold text-brand-700 hover:text-brand-900 transition-colors">{bylineAuthor}</a>
          </span>
          {formattedDate && (
            <span class="inline-flex items-center gap-1.5">
              <Calendar class="w-3.5 h-3.5" /> {formattedDate}
            </span>
          )}
          {linkedBreeds.length > 0 && <span>{linkedBreeds.length} breeds compared</span>}
        </div>

        {linkedBreeds.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-widest text-ink-muted/70 mr-1">
              In this comparison
            </span>
            {linkedBreeds.map((breed) => (
              <a
                href={`/breeds/${breed.slug}`}
                class="inline-flex items-center gap-1.5 rounded-full border border-ink/8 bg-surface-raised px-3.5 py-1.5 text-sm font-semibold text-ink transition-all duration-200 hover:border-brand-400 hover:text-brand-700 hover:-translate-y-0.5"
              >
                {breed.name}
                <ArrowUpRight class="w-3 h-3 opacity-40" />
              </a>
            ))}
          </div>
        )}
      </header>

      {imageUrl && (
        <div class="rounded-3xl overflow-hidden mb-10 aspect-[16/9] bg-brand-50 reveal">
          <img src={imageUrl} alt={comparison.title} class="w-full h-full object-cover" />
        </div>
      )}

      <!-- Comparison table -->
      {linkedBreeds.length > 1 && (
        <div class="mb-12 reveal">
          <BreedComparisonTable breeds={linkedBreeds} selectedCriteria={criteria} />
        </div>
      )}

      <!-- Article body -->
      {comparison.content && (
        <article class="article-content glass-card rounded-3xl p-6 sm:p-10 mb-12 reveal" set:html={comparison.content} />
      )}

      <!-- Verdict -->
      {comparison.verdict && (
        <section class="verdict-block rounded-3xl p-6 sm:p-10 mb-12 reveal">
          <h2 class="display-heading text-2xl sm:text-3xl text-white mb-5">The Verdict</h2>
          <div class="verdict-body" set:html={comparison.verdict} />
        </section>
      )}

      <!-- Breeds in this comparison -->
      {linkedBreeds.length > 0 && (
        <section class="mb-12 reveal">
          <h2 class="display-heading text-xl sm:text-2xl text-ink mb-5">Breeds in This Comparison</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {linkedBreeds.map((breed) => {
              const imgUrl = getMediaUrl(breed.image as Media);
              return (
                <a href={`/breeds/${breed.slug}`} class="card-hover group glass-card rounded-2xl overflow-hidden border-transparent hover:border-brand-200 flex items-center gap-3 p-3">
                  <div class="w-16 h-16 rounded-xl bg-brand-50 overflow-hidden shrink-0">
                    {imgUrl ? (
                      <img src={imgUrl} alt={breed.name} class="w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-brand-200/60 to-brand-50"></div>
                    )}
                  </div>
                  <div class="min-w-0">
                    <h3 class="font-bold text-ink text-sm group-hover:text-brand-700 transition-colors truncate">{breed.name}</h3>
                    <p class="text-xs text-ink-muted mt-0.5">Breed profile</p>
                  </div>
                  <ArrowUpRight class="w-4 h-4 text-ink-muted ml-auto shrink-0" />
                </a>
              );
            })}
          </div>
        </section>
      )}

      <!-- FAQs — mirrored exactly by the FAQPage JSON-LD -->
      {faqs.length > 0 && (
        <section id="faq" class="glass-card rounded-2xl p-6 sm:p-8 mb-12 reveal">
          <h2 class="font-display font-bold text-ink text-xl mb-1.5 flex items-center gap-2">
            <span class="text-lg">❓</span> Common questions
          </h2>
          <p class="text-sm text-ink-muted font-medium mb-6">
            Answered from this comparison.
          </p>
          <div class="divide-y divide-ink/5">
            {faqs.map((faq) => (
              <div class="py-4 first:pt-0 last:pb-0">
                <h3 class="font-display font-bold text-ink text-[0.95rem] mb-2">{faq.question}</h3>
                <p class="text-sm text-ink-light leading-relaxed">{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Related comparisons — shares at least one breed with this one -->
      {related.length > 0 && (
        <section class="mb-12 reveal">
          <h2 class="display-heading text-xl sm:text-2xl text-ink mb-2">Related comparisons</h2>
          <p class="text-sm text-ink-muted font-medium mb-5">
            Other head-to-heads featuring these breeds.
          </p>
          <ul class="grid sm:grid-cols-3 gap-4">
            {related.map((entry) => (
              <li>
                <a
                  href={`/compare/${entry.slug}`}
                  class="group glass-card rounded-2xl p-5 flex flex-col h-full border-transparent hover:border-brand-200 transition-all duration-200 hover:-translate-y-1"
                >
                  <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-brand-700 mb-2">
                    <Scale class="w-3 h-3" /> Comparison
                  </span>
                  <span class="font-display font-bold text-ink text-[0.95rem] leading-snug group-hover:text-brand-700 transition-colors">
                    {entry.title}
                  </span>
                  {entry.summary && (
                    <span class="text-xs text-ink-muted mt-2 line-clamp-3">{entry.summary}</span>
                  )}
                  <span class="mt-auto pt-3 inline-flex items-center gap-1 text-xs font-bold text-brand-700">
                    Read it
                    <ArrowUpRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="mb-8 reveal">
        <AuthorByline
          author={comparison.author}
          published={comparison.publishedDate || comparison.createdAt}
          updated={comparison.updatedAt}
        />
      </div>

      <div class="mb-8 reveal">
        <QuizPromo
          variant="hero"
          heading="Still can't call it?"
          subtitle="Ten questions about your home, your week and your household — then a straight answer on which of these actually suits you, and what you'd be signing up for."
          source="comparison-detail"
        />
      </div>

      <div class="mb-12 reveal">
        <NewsletterSignup
          variant="banner"
          heading="More Breed Comparisons"
          subtitle="New head-to-head breed breakdowns and profile updates, once a week."
          source="comparison-detail"
        />
      </div>

      <div class="text-center reveal">
        <a href="/compare" class="inline-flex items-center gap-2 text-brand-700 font-bold hover:text-brand-900 transition-colors">
          Compare other breeds <ArrowUpRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </main>

  <Footer note="Comparison scores are derived from our breed trait ratings, sourced from kennel club standards." />
</Layout>

<style is:global>
  .article-content h2 {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 1.65rem;
    font-weight: 800;
    color: #122028;
    letter-spacing: -0.02em;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }
  .article-content h2:first-child { margin-top: 0; }
  .article-content h3 {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: #1b2f38;
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
  }
  .article-content p {
    color: #41565f;
    line-height: 1.75;
    margin-bottom: 1.1rem;
  }
  .article-content ul, .article-content ol {
    margin: 0 0 1.25rem 1.25rem;
    color: #41565f;
    line-height: 1.7;
  }
  .article-content li { margin-bottom: 0.5rem; }
  .article-content ul { list-style: disc; }
  .article-content ol { list-style: decimal; }
  .article-content strong { color: #122028; font-weight: 700; }
  .article-content a { color: #0c6076; text-decoration: underline; }

  .verdict-block {
    background: linear-gradient(135deg, #122028, #1b3742);
    box-shadow: 0 24px 48px -24px rgba(18, 32, 40, 0.6);
  }
  .verdict-body p {
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .verdict-body h3 {
    font-family: var(--font-display, 'Outfit', sans-serif);
    color: #fff;
    font-weight: 700;
    font-size: 1.15rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .verdict-body strong { color: #fff; font-weight: 700; }
  .verdict-body ul, .verdict-body ol {
    margin: 0 0 1.1rem 1.25rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.7;
  }
  .verdict-body ul { list-style: disc; }
  .verdict-body ol { list-style: decimal; }

  @media (max-width: 640px) {
    .article-content h2 { font-size: 1.35rem; }
    .article-content h3 { font-size: 1.08rem; }
  }
</style>
