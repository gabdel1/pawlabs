---
import Layout from '../layouts/Layout.astro';
import { websiteJsonLd } from '../lib/seo';
---

<Layout
  title="PawLabs - Expert Pet Product Reviews & Recommendations"
  description="Your trusted source for honest pet product reviews. Compare smart gadgets, toys, food, health products, and more for dogs, cats, and all pets."
  canonicalUrl="/"
  ogType="website"
  jsonLd={websiteJsonLd()}
>
  <main class="min-h-screen bg-gray-50 flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">🐾 Pet Smart Gadgets</h1>
      <p class="text-lg text-gray-600 mb-8">Your trusted source for pet product reviews</p>
      <div class="flex gap-4 justify-center">
        <a href="/products" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-indigo-200">
          Browse Products
        </a>
        <a href="/admin" class="border border-gray-300 hover:border-indigo-300 text-gray-600 hover:text-indigo-600 font-medium py-3 px-6 rounded-xl transition-all duration-200">
          CMS Admin
        </a>
      </div>
    </div>
  </main>
</Layout>
