---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import { getProducts, getMediaUrl, CATEGORY_LABELS } from '../lib/payload';
import type { Media } from '../lib/payload';
import { websiteJsonLd, organizationJsonLd } from '../lib/seo';
import { 
  Activity, ShieldCheck, HeartPulse, Bone, Scissors, Bed, Link as LinkIcon, Plane, 
  Award, Search, ChevronRight, Star, StarHalf, ArrowUpRight, Sparkles, Gamepad2 
} from 'lucide-astro';

const products = await getProducts();
const featuredProducts = products.filter(p => p.featured).slice(0, 6);
const recentProducts = products.slice(0, 6);


const categories = [
  { key: 'smart-gadgets', icon: Activity, label: 'Smart Tech', desc: 'GPS trackers, smart feeders, cameras & more' },
  { key: 'wellness', icon: HeartPulse, label: 'Wellness', desc: 'Litter, supplements, dental & flea care' },
  { key: 'security', icon: ShieldCheck, label: 'Security', desc: 'Cameras, collars, trackers & containment' },
  { key: 'food-treats', icon: Bone, label: 'Food & Treats', desc: 'Premium nutrition and healthy snacks' },
  { key: 'grooming', icon: Scissors, label: 'Grooming', desc: 'Brushes, shampoos, and grooming kits' },
  { key: 'beds-furniture', icon: Bed, label: 'Furniture', desc: 'Cozy beds, trees, and pet furniture' },
  { key: 'leashes-collars', icon: LinkIcon, label: 'Gear', desc: 'Stylish and durable walking gear' },
  { key: 'travel', icon: Plane, label: 'Travel', desc: 'Carriers, car seats, and travel bowls' },
  { key: 'toys', icon: Gamepad2, label: 'Toys', desc: 'Chew toys, interactive toys, and playtime fun' },
];

const trustPoints = [
  { icon: Award, title: 'Research-Backed', desc: 'Every product tested with real-world data, eschewing marketing claims.' },
  { icon: Search, title: 'Total Transparency', desc: 'Side-by-side comparisons so you see how products truly stack up.' },
  { icon: ShieldCheck, title: 'Best Value', desc: 'We link to the best deals — absolutely no hidden fees or middlemen.' },
  { icon: HeartPulse, title: 'Pet-First Philosophy', desc: 'Safety, health, and undeniable happiness above all in our criteria.' },
];
---

<Layout
  title="PawLabs - Expert Pet Product Reviews & Recommendations"
  description="Your trusted source for honest pet product reviews. Compare smart gadgets, toys, food, health products, and more for dogs, cats, and all pets."
  canonicalUrl="/"
  ogType="website"
  jsonLd={[websiteJsonLd(), organizationJsonLd()]}
>
  <!-- Floating Pill Navigation (Modern 2026 style) -->
  <nav class="fixed top-6 left-0 right-0 z-50 flex justify-center px-4 sm:px-6 pointer-events-none">
    <div class="glass-pill px-2 py-2 pr-3 sm:pr-6 rounded-full flex items-center justify-between w-full max-w-5xl pointer-events-auto reveal">
      <div class="flex items-center gap-8 pl-4">
        <a href="/" class="hover:opacity-80 transition-opacity">
          <Logo width={130} height={32} />
        </a>
      </div>
      <div class="hidden md:flex items-center gap-8">
        <a href="/products" class="nav-link text-ink text-sm font-semibold tracking-wide">Products</a>
        <a href="/guides" class="nav-link text-ink text-sm font-semibold tracking-wide">Guides</a>
      </div>
      <div class="flex items-center gap-2">
        <a href="/products" class="btn-primary bg-ink text-white text-sm font-bold py-3 px-5 sm:px-7 rounded-full transition-transform hidden sm:inline-flex">
          Browse All
        </a>
        <!-- Hamburger (mobile only) -->
        <button id="hamburger-btn" class="hamburger-btn md:hidden" aria-label="Open menu" aria-expanded="false">
          <svg class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div id="mobile-overlay" class="mobile-drawer-overlay"></div>
  <div id="mobile-drawer" class="mobile-drawer">
    <div class="flex items-center justify-between mb-4">
      <span class="font-display font-bold text-ink text-lg">Menu</span>
      <button id="drawer-close" class="hamburger-btn" aria-label="Close menu">
        <svg class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <a href="/products">📦 Products</a>
    <a href="/guides">📖 Guides</a>
    <a href="/compare">⚖️ Compare</a>
    <div class="mt-auto pt-6">
      <a href="/products" class="!bg-ink !text-white !rounded-full !justify-center !font-bold">Browse All</a>
    </div>
  </div>

  <!-- Asymmetrical Hero Section -->
  <section class="relative min-h-[85svh] sm:min-h-[90svh] flex items-center pt-28 sm:pt-32 pb-16 sm:pb-20 overflow-hidden noise">
    <!-- Sophisticated Background -->
    <div class="absolute inset-0 bg-surface -z-20"></div>
    <div class="absolute inset-0 hero-gradient -z-10 opacity-80"></div>
    
    <!-- Floating Orbs -->
    <div class="glow-orb w-[300px] sm:w-[600px] h-[300px] sm:h-[600px] bg-brand-300/20 top-[-100px] left-[-200px] animate-orb"></div>
    <div class="glow-orb w-[250px] sm:w-[500px] h-[250px] sm:h-[500px] bg-accent-400/10 bottom-[100px] right-[-100px] animate-orb" style="animation-delay: -5s;"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 w-full relative z-10">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-8 items-center">
        
        <!-- Hero Text -->
        <div class="lg:col-span-7 reveal">
          <div class="inline-flex items-center gap-2.5 glass-pill rounded-full px-4 py-2 mb-6 sm:mb-8 scale-reveal reveal-delay-1 border !border-white/40">
            <Sparkles class="w-4 h-4 text-brand-600" />
            <span class="text-ink-light text-xs font-bold tracking-widest uppercase">Curated for 2026</span>
          </div>

          <h1 class="display-heading display-fluid-xl tracking-tight text-ink mb-6 sm:mb-8 leading-[1.05] text-balance">
            Elevate Your Pet's 
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-brand-700 to-brand-400">Lifestyle.</span>
          </h1>

          <p class="text-base sm:text-lg md:text-xl text-ink-muted max-w-xl mb-8 sm:mb-12 leading-relaxed font-medium text-pretty reveal-delay-2">
            Research-backed reviews, uncompromising comparisons, and the absolute best gear on the market—curated for modern pet parents.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 reveal-delay-3">
            <a href="/products" class="group btn-primary bg-ink text-white font-bold py-4 px-8 sm:px-10 rounded-full text-base transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-ink/20 inline-flex items-center justify-center gap-3">
              Explore Products
              <ArrowUpRight class="w-5 h-5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </a>
            <a href="/products" class="group inline-flex items-center justify-center gap-3 bg-white/50 backdrop-blur-md border border-white/60 text-ink font-bold py-4 px-8 sm:px-10 rounded-full text-base transition-all duration-300 hover:bg-white/80">
              Shop by Category
            </a>
          </div>
        </div>

        <!-- Hero Visual (visible on all sizes, scaled on mobile) -->
        <div class="lg:col-span-5 relative reveal reveal-delay-4">
          <div class="relative w-full aspect-[4/5] max-w-[280px] sm:max-w-none mx-auto rounded-[2rem] sm:rounded-[2.5rem] overflow-hidden glass-card p-3 sm:p-4 border border-white/60 shadow-2xl shadow-brand-900/10 sm:transform sm:rotate-2 sm:hover:rotate-0 transition-transform duration-700">
            <div class="w-full h-full rounded-[1.5rem] sm:rounded-[2rem] bg-brand-100 overflow-hidden relative">
              <img src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?q=80&w=2688&auto=format&fit=crop" alt="Premium Dog" class="w-full h-full object-cover mix-blend-multiply opacity-80 scale-105 hover:scale-100 transition-transform duration-1000" />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-900/40 to-transparent"></div>
              
              <!-- Floating stat card -->
              <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 sm:right-6 glass-pill p-4 sm:p-5 rounded-xl sm:rounded-2xl flex items-center justify-between">
                <div class="flex flex-col">
                  <span class="text-xs font-bold text-ink-light uppercase tracking-wider mb-1">Trusted Reviews</span>
                  <div class="flex items-center gap-2">
                    <span class="text-xl sm:text-2xl font-bold font-display text-ink">{products.length}+</span>
                    <span class="text-brand-600 flex"><Star class="w-4 h-4 fill-current"/><Star class="w-4 h-4 fill-current"/><Star class="w-4 h-4 fill-current"/></span>
                  </div>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white flex items-center justify-center shadow-lg">
                  <Activity class="w-4 h-4 sm:w-5 sm:h-5 text-brand-600" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  {(featuredProducts.length > 0 || recentProducts.length > 0) && (
    <section class="bg-white py-20 sm:py-32 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12 sm:mb-20 reveal">
          <div class="inline-flex items-center gap-2 badge bg-accent-100 text-accent-700 mb-4 sm:mb-6">
            <Star class="w-3.5 h-3.5 fill-current" /> Hand-Picked
          </div>
          <h2 class="display-heading display-fluid-lg text-ink mb-3 sm:mb-4">
            {featuredProducts.length > 0 ? 'Featured Equipment' : 'Latest Additions'}
          </h2>
          <p class="text-ink-muted text-base sm:text-lg max-w-2xl mx-auto">The definitive selections from our extensive testing lab.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8">
          {(featuredProducts.length > 0 ? featuredProducts : recentProducts).map((product, i) => {
            const imgUrl = getMediaUrl(product.image as Media);
            const catLabel = product.category ? CATEGORY_LABELS[product.category] : null;
            
            return (
              <a href={`/products/${product.slug}`} class={`card-hover group glass-card rounded-2xl sm:rounded-[2rem] overflow-hidden reveal reveal-delay-${Math.min((i % 3) + 1, 4)} border-transparent hover:border-brand-200`}>
                <div class="relative bg-surface aspect-[4/3] overflow-hidden p-4 sm:p-6 flex flex-col justify-between">
                  <!-- Badges Top layer -->
                  <div class="flex flex-wrap gap-2 relative z-10">
                    {catLabel && (
                      <span class="badge bg-white/80 backdrop-blur-md text-ink-light border border-white/50 shadow-sm shadow-ink/5">
                        {catLabel}
                      </span>
                    )}
                    {product.featured && (
                      <span class="badge bg-accent-400/90 backdrop-blur-md text-ink font-bold border border-accent-300 shadow-sm">
                        Featured
                      </span>
                    )}
                  </div>
                  
                  {/* Image Layer */}
                  <div class="absolute inset-0 image-layer transition-transform duration-700 ease-out flex items-center justify-center p-6 sm:p-8 bg-gradient-to-br from-brand-50 to-white">
                    {imgUrl ? (
                      <img src={imgUrl} alt={product.name} class="w-full h-full object-contain filter drop-shadow-2xl mix-blend-multiply" loading="lazy" />
                    ) : (
                      <div class="text-7xl opacity-5">📦</div>
                    )}
                  </div>
                </div>

                <div class="p-5 sm:p-8 bg-white glass-card-border-top relative z-20">
                  <h3 class="font-display font-bold text-ink text-lg sm:text-xl group-hover:text-brand-700 transition-colors mb-2 sm:mb-3 leading-tight">
                    {product.name}
                  </h3>
                  
                  {product.rating != null && (
                    <div class="flex items-center gap-2 mb-3 sm:mb-4">
                      <div class="flex items-center gap-0.5 text-accent-500">
                        {Array.from({ length: Math.floor(product.rating) }).map(() => <Star class="w-4 h-4 fill-current" />)}
                        {product.rating % 1 >= 0.5 && <StarHalf class="w-4 h-4 fill-current" />}
                        {Array.from({ length: 5 - Math.floor(product.rating) - (product.rating % 1 >= 0.5 ? 1 : 0) }).map(() => <Star class="w-4 h-4 text-gray-300" />)}
                      </div>
                      <span class="font-bold text-ink-light text-sm">{product.rating.toFixed(1)}</span>
                    </div>
                  )}
                  
                  {product.shortDescription && (
                    <p class="text-sm text-ink-muted line-clamp-2 mb-4 sm:mb-6 text-pretty">{product.shortDescription}</p>
                  )}
                  
                  <div class="flex items-center justify-between pt-3 sm:pt-4 border-t border-surface">
                    {product.price != null && (
                      <span class="text-xl sm:text-2xl font-bold font-display text-ink tracking-tight">${product.price.toFixed(2)}</span>
                    )}
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-surface text-brand-700 group-hover:bg-brand-600 group-hover:text-white transition-colors duration-300">
                      <ChevronRight class="w-5 h-5" />
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        <div class="mt-12 sm:mt-16 text-center reveal reveal-delay-4">
          <a href="/products" class="btn-primary inline-flex items-center justify-center gap-2 bg-ink text-white font-bold py-4 px-8 sm:px-10 rounded-full text-base transition-all duration-300 hover:shadow-xl">
            View Complete Catalog
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Categories — Refined Bento Grid -->
  <section id="categories" class="bg-surface py-20 sm:py-32 relative noise">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 sm:mb-16 gap-4 sm:gap-6 reveal">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 badge bg-brand-100 text-brand-800 mb-4 sm:mb-6">
            <Search class="w-3.5 h-3.5" /> Explore
          </div>
          <h2 class="display-heading display-fluid-lg text-ink mb-3 sm:mb-4">Meticulously Organized.</h2>
          <p class="text-ink-muted text-base sm:text-lg text-balance">Navigate our comprehensive library by category to locate precisely what your companion requires.</p>
        </div>
        <a href="/products" class="inline-flex items-center gap-2 text-brand-700 font-bold hover:text-brand-900 transition-colors group">
          View All Categories
          <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
        </a>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-5">
        {categories.map((cat, i) => {
          const IconComponent = cat.icon;
          const isLarge = i === 0 || i === 3;

          return (
            <a
              href={`/products?category=${cat.key}`}
              class={`card-hover group glass-card rounded-2xl sm:rounded-3xl p-5 sm:p-8 relative overflow-hidden reveal reveal-delay-${Math.min((i % 4) + 1, 6)} ${isLarge ? 'sm:col-span-2' : ''}`}
            >
              <div class="flex items-start justify-between mb-4 sm:mb-8">
                <div class="icon-layer w-10 h-10 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-brand-50 flex items-center justify-center text-brand-700 transition-all duration-300">
                  <IconComponent class="w-5 h-5 sm:w-7 sm:h-7" />
                </div>
                <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-surface-raised border border-brand-100 flex items-center justify-center text-ink-muted group-hover:bg-brand-600 group-hover:text-white transition-colors duration-300">
                  <ArrowUpRight class="w-3.5 h-3.5 sm:w-4 sm:h-4" />
                </div>
              </div>
              <h3 class="font-display font-bold text-ink text-base sm:text-xl group-hover:text-brand-700 transition-colors mb-1 sm:mb-2">{cat.label}</h3>
              <p class="text-xs sm:text-sm text-ink-muted max-w-sm line-clamp-2 hidden sm:block">{cat.desc}</p>
              
              <!-- Subtle background glow on hover -->
              <div class="absolute -right-20 -bottom-20 w-40 h-40 bg-brand-200/40 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Trust Matrix (Refined) -->
  <section class="bg-ink py-20 sm:py-32 relative overflow-hidden">
    <!-- Dark decorative elements -->
    <div class="absolute top-0 right-0 w-[400px] sm:w-[800px] h-[400px] sm:h-[800px] bg-brand-900/40 rounded-full blur-[120px] pointer-events-none -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-[300px] sm:w-[600px] h-[300px] sm:h-[600px] bg-accent-900/10 rounded-full blur-[100px] pointer-events-none translate-y-1/2 -translate-x-1/2"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="text-center mb-12 sm:mb-20 reveal">
        <h2 class="display-heading display-fluid-lg text-white mb-4 sm:mb-6">Our Methodology.</h2>
        <p class="text-ink-muted max-w-2xl mx-auto text-base sm:text-lg text-balance opacity-80">We conduct rigorous analysis so you can make confident decisions. Our reviews are inherently objective.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 md:gap-8">
        {trustPoints.map((point, i) => {
          const IconComponent = point.icon;
          return (
            <div class={`glass-card-dark rounded-2xl sm:rounded-3xl p-5 sm:p-8 card-hover reveal reveal-delay-${i + 1}`}>
              <div class="w-10 h-10 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-white/10 flex items-center justify-center text-accent-400 mb-4 sm:mb-6 border border-white/5">
                <IconComponent class="w-5 h-5 sm:w-6 sm:h-6" />
              </div>
              <h3 class="font-display font-bold text-white mb-2 sm:mb-3 text-base sm:text-xl">{point.title}</h3>
              <p class="text-xs sm:text-sm text-ink-muted leading-relaxed opacity-90">{point.desc}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Comparison CTA -->
  <section class="relative py-20 sm:py-32 overflow-hidden subtle-bg-glow border-t border-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center reveal">
      <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-brand-100 text-brand-700 mb-6 sm:mb-8 border border-white shadow-xl shadow-brand-200/50">
        <ShieldCheck class="w-8 h-8 sm:w-10 sm:h-10" />
      </div>
      <h2 class="display-heading display-fluid-lg text-ink mb-6 sm:mb-8 text-balance">
        Uncertain? <span class="gradient-text">Compare Them.</span>
      </h2>
      <p class="text-ink-muted text-base sm:text-xl mb-8 sm:mb-12 max-w-2xl mx-auto font-medium text-pretty">
        Utilize our robust side-by-side comparison engine to evaluate features, pricing, and independent ratings seamlessly.
      </p>
      <a href="/products#compare" class="btn-primary inline-flex items-center justify-center gap-3 bg-brand-600 text-white font-bold py-4 px-8 sm:px-10 rounded-full text-base sm:text-lg transition-all duration-300 hover:shadow-2xl hover:shadow-brand-600/30">
        Start Comparing <ArrowUpRight class="w-5 h-5" />
      </a>
    </div>
  </section>

  <!-- Modern Footer -->
  <footer class="bg-surface py-16 sm:py-20 border-t border-ink/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-8 sm:gap-12 lg:gap-16 mb-12 sm:mb-16">
        <!-- Brand -->
        <div class="sm:col-span-2">
          <div class="mb-6 sm:mb-8">
            <Logo width={160} height={40} />
          </div>
          <p class="text-base leading-relaxed text-ink-muted max-w-sm text-pretty font-medium">
            Empowering pet parents through rigorous testing, honest reviews, and data-driven recommendations.
          </p>
        </div>

        <!-- Links -->
        <div>
          <h4 class="font-display text-ink font-bold mb-4 sm:mb-6 text-sm uppercase tracking-widest">Library</h4>
          <ul class="space-y-3 sm:space-y-4 text-sm font-medium text-ink-muted">
            <li><a href="/products" class="hover:text-brand-600 transition-colors">Complete Catalog</a></li>
            <li><a href="/products?category=smart-gadgets" class="hover:text-brand-600 transition-colors">Smart Tech</a></li>
            <li><a href="/products?category=wellness" class="hover:text-brand-600 transition-colors">Health & Wellness</a></li>
            <li><a href="/products" class="hover:text-brand-600 transition-colors">All Categories</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-display text-ink font-bold mb-4 sm:mb-6 text-sm uppercase tracking-widest">Platform</h4>
          <ul class="space-y-3 sm:space-y-4 text-sm font-medium text-ink-muted">
            <li><a href="/about" class="hover:text-brand-600 transition-colors">Our Methodology</a></li>
            <li><a href="/contact" class="hover:text-brand-600 transition-colors">Contact Us</a></li>
            <li><a href="/admin" class="hover:text-brand-600 transition-colors">Admin Login</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-ink/10 pt-6 sm:pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 sm:gap-6 text-sm text-ink-light font-medium">
        <p>&copy; {new Date().getFullYear()} PawLabs. All rights reserved.</p>
        <p class="text-ink-muted">Affiliate Disclosure: We may earn commissions from qualifying purchases.</p>
      </div>
    </div>
  </footer>

  <!-- Mobile Nav Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('hamburger-btn');
      const overlay = document.getElementById('mobile-overlay');
      const drawer = document.getElementById('mobile-drawer');
      const closeBtn = document.getElementById('drawer-close');
      if (!btn || !overlay || !drawer) return;

      function openDrawer() {
        overlay.classList.add('open');
        drawer.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
      function closeDrawer() {
        overlay.classList.remove('open');
        drawer.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      btn.addEventListener('click', openDrawer);
      overlay.addEventListener('click', closeDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    });
  </script>
</Layout>
