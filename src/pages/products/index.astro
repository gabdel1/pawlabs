---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Logo from '../../components/Logo.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getProducts, getMediaUrl, CATEGORY_LABELS, PET_TYPE_LABELS, getSubcategoryLabel } from '../../lib/payload';
import type { Media } from '../../lib/payload';
import { productsListJsonLd } from '../../lib/seo';
import { 
  Search, ChevronRight, Star, StarHalf, PackageSearch 
} from 'lucide-astro';

const products = await getProducts();

// Collect unique categories for filter pills
const categorySet = new Set<string>();
products.forEach(p => { if (p.category) categorySet.add(p.category); });
const categories = Array.from(categorySet).sort();


const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Catalog' },
];
---

<Layout
  title="Complete Catalog - PawLabs Reviews & Comparisons"
  description="Browse expert reviews of the best pet products — smart gadgets, wellness, security, food, and more for dogs, cats, and all pets."
  canonicalUrl="/products"
  ogType="website"
  jsonLd={productsListJsonLd(products)}
>
  <Nav activePage="products" />

  <main class="min-h-screen bg-surface noise pt-32 sm:pt-36">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <div class="mb-8 sm:mb-12 reveal">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <div class="mb-10 sm:mb-16 reveal reveal-delay-1 flex xl:items-end xl:justify-between flex-col xl:flex-row gap-4 sm:gap-6">
        <div>
          <h1 class="display-heading display-fluid-lg text-ink mb-3 sm:mb-4 text-balance">Complete Catalog</h1>
          <p class="text-ink-muted text-base sm:text-lg max-w-2xl text-pretty font-medium">Impartial analysis and comparative data across {products.length} superior selections in pet equipment.</p>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
          <button
            id="compare-toggle"
            class="compare-toggle-btn inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl text-sm font-bold transition-all duration-300 border border-ink/10 bg-white text-ink hover:border-brand-500 hover:text-brand-700 cursor-pointer min-h-[44px]"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            <span>Compare</span>
          </button>
          <div class="glass flex items-center gap-3 px-4 py-3 rounded-2xl w-full sm:max-w-xs border border-ink/10 bg-white min-h-[44px]">
            <Search class="w-5 h-5 text-ink-muted" />
            <input type="text" placeholder="Search catalog..." class="bg-transparent border-none outline-none font-medium text-ink w-full placeholder:text-ink-muted/50" />
          </div>
        </div>
      </div>

      {/* Category Filter Pills */}
      {categories.length > 1 && (
        <div class="mb-8 sm:mb-10 reveal reveal-delay-2">
          <div id="category-filters" class="scroll-x-snap sm:flex sm:flex-wrap">
            <button
              data-filter="all"
              class="category-pill active-pill px-5 py-2.5 rounded-full text-sm font-bold transition-all duration-300 cursor-pointer border-2 min-h-[44px]"
            >
              All Products
              <span class="ml-1.5 text-xs opacity-70">({products.length})</span>
            </button>
            {categories.map(cat => {
              const count = products.filter(p => p.category === cat).length;
              return (
                <button
                  data-filter={cat}
                  class="category-pill inactive-pill px-5 py-2.5 rounded-full text-sm font-bold transition-all duration-300 cursor-pointer border-2 min-h-[44px]"
                >
                  {CATEGORY_LABELS[cat] ?? cat}
                  <span class="ml-1.5 text-xs opacity-70">({count})</span>
                </button>
              );
            })}
          </div>
        </div>
      )}

      {products.length === 0 ? (
        <div class="text-center py-32 reveal flex flex-col items-center justify-center">
          <div class="w-24 h-24 rounded-[2rem] bg-brand-50 text-brand-400 flex items-center justify-center mb-6 border border-brand-100 shadow-xl shadow-brand-100/50">
            <PackageSearch class="w-12 h-12" />
          </div>
          <p class="text-ink-muted text-xl mb-8 font-medium">The catalog is currently being updated.</p>
          <a href="/admin" class="btn-primary inline-flex items-center justify-center gap-2 bg-ink text-white font-bold py-4 px-10 rounded-full text-base transition-all duration-300">
            Access CMS Admin <ChevronRight class="w-5 h-5" />
          </a>
        </div>
      ) : (
        <div id="products-grid" class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 md:gap-10">
          {products.map((product, i) => {
            const imgUrl = getMediaUrl(product.image as Media);
            const categoryLabel = product.category ? CATEGORY_LABELS[product.category] : null;
            const animalTypes = (product as any).animalTypes as string[] | undefined;
            
            return (
              <div class={`product-card-wrapper relative reveal reveal-delay-${Math.min((i % 3) + 1, 4)}`} data-slug={product.slug} data-name={product.name} data-category={product.category || ''}>
                {/* Compare checkbox overlay — hidden by default */}
                <button
                  class="compare-checkbox absolute top-4 right-4 z-30 w-10 h-10 rounded-xl border-2 border-brand-300 bg-white/90 backdrop-blur-md flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 cursor-pointer hover:border-brand-600 hover:scale-110 shadow-lg"
                  aria-label={`Select ${product.name} for comparison`}
                >
                  <svg class="check-icon w-5 h-5 text-white opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </button>

                <a href={`/products/${product.slug}`} class="product-card-link card-hover group glass-card rounded-2xl sm:rounded-[2rem] overflow-hidden border-transparent hover:border-brand-200 block">
                  <div class="relative bg-surface aspect-[4/3] overflow-hidden p-3 sm:p-6 flex flex-col justify-between">
                    {/* Badges Top layer */}
                    <div class="flex flex-wrap gap-2 relative z-10">
                      {categoryLabel && (
                        <span class="badge bg-white/80 backdrop-blur-md text-ink-light border border-white/50 shadow-sm shadow-ink/5">
                          {categoryLabel}
                        </span>
                      )}
                      {product.featured && (
                        <span class="badge bg-accent-400/90 backdrop-blur-md text-ink font-bold border border-accent-300 shadow-sm">
                          Featured
                        </span>
                      )}
                    </div>
                    
                    {/* Image Layer */}
                    <div class="absolute inset-0 image-layer transition-transform duration-700 ease-out flex items-center justify-center p-8 bg-gradient-to-br from-brand-50 to-white">
                      {imgUrl ? (
                        <img src={imgUrl} alt={product.name} class="w-full h-full object-contain filter drop-shadow-2xl mix-blend-multiply" loading="lazy" />
                      ) : (
                        <div class="text-7xl opacity-5"><PackageSearch class="w-16 h-16"/></div>
                      )}
                    </div>
                  </div>

                  <div class="p-4 sm:p-8 bg-white glass-card-border-top relative z-20">
                    <h2 class="font-display font-bold text-ink text-sm sm:text-xl group-hover:text-brand-700 transition-colors mb-1 sm:mb-2 leading-tight line-clamp-2">
                      {product.name}
                    </h2>
                    
                    <div class="flex items-center gap-2 sm:gap-3 mb-2 sm:mb-4">
                      {product.rating != null && (
                        <div class="flex items-center gap-1 sm:gap-2">
                          <div class="flex items-center gap-0.5 text-accent-500">
                            {Array.from({ length: Math.floor(product.rating) }).map(() => <Star class="w-3 h-3 sm:w-4 sm:h-4 fill-current" />)}
                            {product.rating % 1 >= 0.5 && <StarHalf class="w-3 h-3 sm:w-4 sm:h-4 fill-current" />}
                            {Array.from({ length: 5 - Math.floor(product.rating) - (product.rating % 1 >= 0.5 ? 1 : 0) }).map(() => <Star class="w-3 h-3 sm:w-4 sm:h-4 text-gray-300" />)}
                          </div>
                          <span class="font-bold text-ink-light text-xs sm:text-sm">{product.rating.toFixed(1)}</span>
                        </div>
                      )}
                      {animalTypes && animalTypes.map((type) => (
                        <span class="text-xs font-bold text-ink-muted uppercase tracking-widest px-2 border-l border-surface">
                          {PET_TYPE_LABELS[type] ?? type}
                        </span>
                      ))}
                    </div>

                    {product.shortDescription && (
                      <p class="text-xs sm:text-sm text-ink-muted line-clamp-2 mb-3 sm:mb-6 text-pretty hidden sm:block">{product.shortDescription}</p>
                    )}
                    
                    <div class="flex items-center justify-between pt-3 sm:pt-4 border-t border-surface">
                      {product.price != null && (
                        <span class="text-lg sm:text-2xl font-bold font-display text-ink tracking-tight">${product.price.toFixed(2)}</span>
                      )}
                      <span class="inline-flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-surface text-brand-700 group-hover:bg-brand-600 group-hover:text-white transition-colors duration-300">
                        <ChevronRight class="w-4 h-4 sm:w-5 sm:h-5" />
                      </span>
                    </div>
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <!-- Sticky Compare Bar (hidden by default) -->
  <div id="compare-bar" class="compare-bar fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-500 ease-out pointer-events-none">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 safe-bottom">
      <div class="glass-pill rounded-2xl px-4 sm:px-6 py-3 sm:py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-6 shadow-2xl shadow-ink/20 pointer-events-auto border !border-brand-200">
        <div class="flex items-center gap-3 sm:gap-4 min-w-0 overflow-hidden w-full sm:w-auto">
          <div class="flex items-center gap-2 shrink-0">
            <svg class="w-5 h-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            <span id="compare-count" class="font-bold text-ink text-sm">0 selected</span>
          </div>
          <div id="compare-pills" class="flex items-center gap-2 flex-wrap min-w-0"></div>
        </div>
        <div class="flex items-center gap-3 shrink-0 w-full sm:w-auto">
          <button id="compare-clear" class="text-sm font-medium text-ink-muted hover:text-red-600 transition-colors cursor-pointer min-h-[44px]">Clear</button>
          <a id="compare-go-btn" href="#" class="compare-go-btn inline-flex items-center gap-2 bg-brand-600 text-white font-bold text-sm py-3 px-6 rounded-xl transition-all duration-300 opacity-50 pointer-events-none hover:bg-brand-700 hover:shadow-lg flex-1 sm:flex-initial justify-center min-h-[44px]">
            Compare Now
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Modern Simple Footer -->
  <footer class="bg-surface py-12 sm:py-16 border-t border-ink/5 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 sm:gap-6">
      <Logo width={140} height={34} />
      <p class="text-ink-muted text-xs sm:text-sm font-medium text-center sm:text-left">
        &copy; {new Date().getFullYear()} PawLabs. Affiliate Disclosure: We may earn commissions.
      </p>
    </div>
  </footer>

  <style>
    .category-pill { user-select: none; }
    .active-pill {
      background: var(--color-ink, #1a1a2e);
      color: white;
      border-color: var(--color-ink, #1a1a2e);
      box-shadow: 0 4px 14px rgba(26, 26, 46, 0.2);
    }
    .inactive-pill {
      background: white;
      color: var(--color-ink-light, #555);
      border-color: var(--color-ink, #1a1a2e)10;
    }
    .inactive-pill:hover {
      background: var(--color-brand-50, #f0fdf4);
      border-color: var(--color-brand-300, #86efac);
      color: var(--color-brand-700, #15803d);
    }
    .product-card-wrapper {
      transition: opacity 0.35s ease, transform 0.35s ease;
    }
    .product-card-wrapper.filtered-out {
      opacity: 0 !important;
      transform: scale(0.95);
      pointer-events: none;
      position: absolute;
      visibility: hidden;
    }
    #no-results-msg {
      transition: opacity 0.3s ease;
    }
  </style>

  <!-- Compare Mode + Category Filter + Search Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('compare-toggle');
      const bar = document.getElementById('compare-bar');
      const pillsContainer = document.getElementById('compare-pills');
      const countLabel = document.getElementById('compare-count');
      const goBtn = document.getElementById('compare-go-btn');
      const clearBtn = document.getElementById('compare-clear');
      const cards = document.querySelectorAll('.product-card-wrapper');
      const checkboxes = document.querySelectorAll('.compare-checkbox');
      const categoryPills = document.querySelectorAll('.category-pill');
      const searchInput = document.querySelector('input[placeholder="Search catalog..."]');
      const grid = document.getElementById('products-grid');

      let compareMode = false;
      let selected = [];
      let lockedCategory = null;
      let activeCategory = 'all';
      let searchQuery = '';

      // ── Category Filtering ──
      function applyFilters() {
        let visibleCount = 0;
        cards.forEach(card => {
          const category = card.dataset.category || '';
          const name = (card.dataset.name || '').toLowerCase();
          const matchesCategory = activeCategory === 'all' || category === activeCategory;
          const matchesSearch = !searchQuery || name.includes(searchQuery.toLowerCase());

          if (matchesCategory && matchesSearch) {
            card.classList.remove('filtered-out');
            visibleCount++;
          } else {
            card.classList.add('filtered-out');
          }
        });

        // Show/hide no results message
        let msg = document.getElementById('no-results-msg');
        if (visibleCount === 0) {
          if (!msg) {
            msg = document.createElement('div');
            msg.id = 'no-results-msg';
            msg.className = 'col-span-full text-center py-20';
            msg.innerHTML = '<p class="text-ink-muted text-lg font-medium">No products match your filters.</p>';
            grid.appendChild(msg);
          }
          msg.style.display = '';
        } else if (msg) {
          msg.style.display = 'none';
        }

        // Update pills active state
        categoryPills.forEach(pill => {
          if (pill.dataset.filter === activeCategory) {
            pill.classList.remove('inactive-pill');
            pill.classList.add('active-pill');
          } else {
            pill.classList.remove('active-pill');
            pill.classList.add('inactive-pill');
          }
        });
      }

      categoryPills.forEach(pill => {
        pill.addEventListener('click', () => {
          activeCategory = pill.dataset.filter;
          // Update URL without reload
          const url = new URL(window.location);
          if (activeCategory === 'all') {
            url.searchParams.delete('category');
          } else {
            url.searchParams.set('category', activeCategory);
          }
          history.replaceState(null, '', url);
          applyFilters();
        });
      });

      // Search input
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim();
          applyFilters();
        });
      }

      // Init from URL param
      const urlParams = new URLSearchParams(window.location.search);
      const urlCategory = urlParams.get('category');
      if (urlCategory) {
        activeCategory = urlCategory;
      }
      applyFilters();

      // ── Compare Mode ──
      function activateCompareMode() {
        compareMode = true;
        toggle.classList.add('compare-active');
        toggle.querySelector('span').textContent = 'Exit Compare';
        checkboxes.forEach(cb => {
          cb.classList.remove('opacity-0', 'pointer-events-none');
          cb.classList.add('opacity-100');
        });
        bar.classList.remove('translate-y-full');
        updateCompareUI();
      }

      function deactivateCompareMode() {
        compareMode = false;
        toggle.classList.remove('compare-active');
        toggle.querySelector('span').textContent = 'Compare';
        checkboxes.forEach(cb => {
          cb.classList.add('opacity-0', 'pointer-events-none');
          cb.classList.remove('opacity-100');
        });
        bar.classList.add('translate-y-full');
        selected = [];
        lockedCategory = null;
        updateCompareUI();
      }

      function updateCompareUI() {
        lockedCategory = selected.length > 0 ? selected[0].category : null;

        countLabel.textContent = selected.length === 0
          ? 'Select products'
          : `${selected.length} selected`;

        pillsContainer.innerHTML = '';
        selected.forEach(s => {
          const pill = document.createElement('span');
          pill.className = 'inline-flex items-center gap-1 text-xs font-semibold text-brand-800 bg-brand-50 border border-brand-200 px-2.5 py-1 rounded-lg';
          const shortName = s.name.length > 25 ? s.name.substring(0, 22) + '…' : s.name;
          pill.textContent = shortName;
          pillsContainer.appendChild(pill);
        });

        if (selected.length >= 2) {
          const slugs = selected.map(s => s.slug).join(',');
          goBtn.href = `/compare?products=${slugs}`;
          goBtn.classList.remove('opacity-50', 'pointer-events-none');
        } else {
          goBtn.href = '#';
          goBtn.classList.add('opacity-50', 'pointer-events-none');
        }

        cards.forEach(card => {
          const slug = card.dataset.slug;
          const category = card.dataset.category;
          const checkbox = card.querySelector('.compare-checkbox');
          const checkIcon = checkbox.querySelector('.check-icon');
          const isSelected = selected.some(s => s.slug === slug);
          const isSameCategory = !lockedCategory || category === lockedCategory;

          if (compareMode && lockedCategory && !isSameCategory) {
            card.style.opacity = '0.35';
            card.style.pointerEvents = 'none';
            checkbox.classList.add('opacity-0', 'pointer-events-none');
            checkbox.classList.remove('opacity-100');
          } else if (compareMode) {
            card.style.opacity = '';
            card.style.pointerEvents = '';
            checkbox.classList.remove('opacity-0', 'pointer-events-none');
            checkbox.classList.add('opacity-100');
          } else {
            card.style.opacity = '';
            card.style.pointerEvents = '';
          }

          if (isSelected) {
            checkbox.classList.add('bg-brand-600', 'border-brand-600');
            checkbox.classList.remove('bg-white/90', 'border-brand-300');
            checkIcon.classList.remove('opacity-0');
            checkIcon.classList.add('opacity-100');
            card.querySelector('.product-card-link').classList.add('ring-2', 'ring-brand-400', 'ring-offset-2');
          } else {
            checkbox.classList.remove('bg-brand-600', 'border-brand-600');
            checkbox.classList.add('bg-white/90', 'border-brand-300');
            checkIcon.classList.add('opacity-0');
            checkIcon.classList.remove('opacity-100');
            card.querySelector('.product-card-link').classList.remove('ring-2', 'ring-brand-400', 'ring-offset-2');
          }
        });
      }

      toggle.addEventListener('click', () => {
        compareMode ? deactivateCompareMode() : activateCompareMode();
      });

      clearBtn.addEventListener('click', () => {
        selected = [];
        lockedCategory = null;
        updateCompareUI();
      });

      checkboxes.forEach(cb => {
        cb.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const card = cb.closest('.product-card-wrapper');
          const slug = card.dataset.slug;
          const name = card.dataset.name;
          const category = card.dataset.category;

          const idx = selected.findIndex(s => s.slug === slug);
          if (idx > -1) {
            selected.splice(idx, 1);
            if (selected.length === 0) lockedCategory = null;
          } else {
            if (lockedCategory && category !== lockedCategory) return;
            selected.push({ slug, name, category });
          }
          updateCompareUI();
        });
      });

      if (window.location.hash === '#compare') {
        activateCompareMode();
      }
    });
  </script>

  <!-- Mobile Nav Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('hamburger-btn');
      const overlay = document.getElementById('mobile-overlay');
      const drawer = document.getElementById('mobile-drawer');
      const closeBtn = document.getElementById('drawer-close');
      if (!btn || !overlay || !drawer) return;
      function openDrawer() {
        overlay.classList.add('open');
        drawer.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
      function closeDrawer() {
        overlay.classList.remove('open');
        drawer.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
      btn.addEventListener('click', openDrawer);
      overlay.addEventListener('click', closeDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    });
  </script>
</Layout>
