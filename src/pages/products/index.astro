---
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getProducts, getMediaUrl, CATEGORY_LABELS, PET_TYPE_LABELS, getSubcategoryLabel } from '../../lib/payload';
import type { Media } from '../../lib/payload';

const products = await getProducts();

function renderStars(rating: number | undefined): string {
  if (rating == null) return '';
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5 ? 1 : 0;
  const empty = 5 - full - half;
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
}

const breadcrumbs = [
  { label: '🐾 Home', href: '/' },
  { label: 'Products' },
];
---

<Layout
  title="All Pet Products - PawLabs Reviews & Comparisons"
  description="Browse expert reviews of the best pet products — smart gadgets, wellness, security, food, and more for dogs, cats, and all pets."
  canonicalUrl="/products"
  ogType="website"
>
  <!-- Sticky Nav -->
  <nav class="bg-white/95 backdrop-blur-md border-b border-gray-100 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/">
        <Logo width={160} height={40} />
      </a>
      <div class="flex items-center gap-6">
        <a href="/products" class="text-brand-800 text-sm font-semibold">Products</a>
        <a href="/#categories" class="text-ink-light text-sm font-medium hover:text-brand-800 transition-colors hidden sm:inline">Categories</a>
      </div>
    </div>
  </nav>

  <Breadcrumbs items={breadcrumbs} />

  <main class="min-h-screen bg-surface">
    <div class="max-w-6xl mx-auto px-6 py-10">
      <h1 class="text-3xl md:text-4xl font-bold text-ink mb-2">All Products</h1>
      <p class="text-ink-muted mb-8">Expert reviews and honest comparisons — {products.length} product{products.length !== 1 ? 's' : ''} reviewed.</p>

      {products.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-6xl mb-4">📦</p>
          <p class="text-ink-muted text-lg">No products yet. Add some in the <a href="/admin" class="text-brand-800 underline">CMS admin</a>.</p>
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {products.map((product) => {
            const imgUrl = getMediaUrl(product.image as Media);
            const categoryLabel = product.category ? CATEGORY_LABELS[product.category] : null;
            const subcategoryLabel = (product.category && product.subcategory) ? getSubcategoryLabel(product.category, product.subcategory) : null;
            const animalTypes = (product as any).animalTypes as string[] | undefined;
            return (
              <a href={`/products/${product.slug}`} class="card-hover group bg-surface-raised rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center p-6 min-h-[180px]">
                  {imgUrl ? (
                    <img src={imgUrl} alt={product.name} class="max-w-full max-h-36 object-contain rounded-lg group-hover:scale-105 transition-transform duration-200" />
                  ) : (
                    <div class="text-6xl opacity-15 group-hover:opacity-25 transition-opacity">📦</div>
                  )}
                </div>
                <div class="p-5">
                  <div class="flex flex-wrap gap-1.5 mb-2">
                    {categoryLabel && (
                      <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-brand-50 text-brand-800">
                        {categoryLabel}
                      </span>
                    )}
                    {subcategoryLabel && (
                      <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-teal-50 text-teal-700">
                        {subcategoryLabel}
                      </span>
                    )}
                    {animalTypes && animalTypes.map((type) => (
                      <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">
                        {PET_TYPE_LABELS[type] ?? type}
                      </span>
                    ))}
                    {product.featured && (
                      <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-50 text-amber-600">
                        ⭐ Featured
                      </span>
                    )}
                  </div>
                  <h2 class="font-bold text-ink group-hover:text-brand-800 transition-colors mb-1">
                    {product.name}
                  </h2>
                  {product.rating != null && (
                    <p class="text-sm text-amber-500 mb-1">{renderStars(product.rating)} <span class="text-ink-muted text-xs">{product.rating}/5</span></p>
                  )}
                  {product.shortDescription && (
                    <p class="text-sm text-ink-muted line-clamp-2 mb-3">{product.shortDescription}</p>
                  )}
                  <div class="flex items-center justify-between">
                    {product.price != null && (
                      <span class="text-lg font-bold text-ink">${product.price.toFixed(2)}</span>
                    )}
                    <span class="text-xs text-brand-800 font-medium group-hover:underline">Read Review →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-ink py-10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <Logo width={120} height={30} variant="white" />
      <p class="text-gray-500 text-xs">
        Affiliate Disclosure: We may earn commissions from qualifying purchases.
      </p>
    </div>
  </footer>
</Layout>
