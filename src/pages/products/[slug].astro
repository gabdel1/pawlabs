---
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getProducts, getProductBySlug, getReviewsForProduct, getMediaUrl, CATEGORY_LABELS, PET_TYPE_LABELS, getSubcategoryLabel } from '../../lib/payload';
import type { Product, Review, Media } from '../../lib/payload';
import { productJsonLd, reviewJsonLd, productFaqJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };
const reviews = await getReviewsForProduct(product.id);
const imageUrl = getMediaUrl(product.image as Media);
const categoryLabel = product.category ? CATEGORY_LABELS[product.category] ?? product.category : null;
const subcategoryLabel = (product.category && product.subcategory) ? getSubcategoryLabel(product.category, product.subcategory) : null;
const petTypeLabel = product.petType ? PET_TYPE_LABELS[product.petType] ?? product.petType : null;
const animalTypes = (product as any).animalTypes as string[] | undefined;

const faqLd = productFaqJsonLd(product);
const jsonLdScripts = [
  productJsonLd(product),
  ...reviews.map((r) => reviewJsonLd(r, product)),
  ...(faqLd ? [faqLd] : []),
];

function renderStars(rating: number | undefined): string {
  if (!rating) return '';
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5 ? 1 : 0;
  const empty = 5 - full - half;
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
}

// Hierarchical breadcrumbs: Home > Category > Subcategory > Product
const breadcrumbs = [
  { label: '🐾 Home', href: '/' },
  { label: 'Products', href: '/products' },
  ...(categoryLabel ? [{ label: categoryLabel, href: `/products?category=${product.category}` }] : []),
  ...(subcategoryLabel ? [{ label: subcategoryLabel, href: `/products?category=${product.category}&sub=${product.subcategory}` }] : []),
  { label: product.name },
];
---

<Layout
  title={`${product.name} Review (2026) - PawLabs`}
  description={product.shortDescription || `Detailed review of ${product.name} — honest assessment with pros, cons, and where to buy.`}
  canonicalUrl={`/products/${product.slug}`}
  ogType="product"
  ogImage={imageUrl}
  jsonLd={jsonLdScripts}
  publishedTime={product.createdAt}
  modifiedTime={product.updatedAt}
>
  <!-- Sticky Nav -->
  <nav class="bg-white/95 backdrop-blur-md border-b border-gray-100 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/">
        <Logo width={160} height={40} />
      </a>
      <div class="flex items-center gap-6">
        <a href="/products" class="text-ink-light text-sm font-medium hover:text-brand-800 transition-colors">Products</a>
        <a href="/products" class="bg-brand-800 hover:bg-brand-900 text-white text-sm font-semibold py-2 px-5 rounded-xl transition-colors">
          Browse All
        </a>
      </div>
    </div>
  </nav>

  <Breadcrumbs items={breadcrumbs} />

  <main class="min-h-screen bg-surface">
    <div class="max-w-6xl mx-auto px-6 py-10">
      <!-- Product Header -->
      <div class="bg-surface-raised rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="grid md:grid-cols-2 gap-0">
          <!-- Product Image -->
          <div class="bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center p-10 min-h-[320px]">
            {imageUrl ? (
              <img src={imageUrl} alt={product.name} class="max-w-full max-h-80 object-contain rounded-lg" />
            ) : (
              <div class="text-8xl opacity-30">📦</div>
            )}
          </div>

          <!-- Product Info -->
          <div class="p-8 flex flex-col justify-center">
            <div class="flex flex-wrap gap-2 mb-3">
              {categoryLabel && (
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-50 text-brand-800">
                  {categoryLabel}
                </span>
              )}
              {subcategoryLabel && (
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-teal-50 text-teal-700">
                  {subcategoryLabel}
                </span>
              )}
              {animalTypes && animalTypes.length > 0 ? (
                animalTypes.map((type) => (
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700">
                    🐾 {PET_TYPE_LABELS[type] ?? type}
                  </span>
                ))
              ) : petTypeLabel && (
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700">
                  🐾 {petTypeLabel}
                </span>
              )}
              {product.featured && (
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-700">
                  ⭐ Featured
                </span>
              )}
            </div>

            <h1 class="text-3xl font-bold text-ink mb-3">{product.name}</h1>

            {product.rating != null && (
              <div class="flex items-center gap-2 mb-4">
                <span class="text-xl text-amber-500">{renderStars(product.rating)}</span>
                <span class="text-sm text-ink-muted font-medium">{product.rating}/5</span>
              </div>
            )}

            {product.shortDescription && (
              <p class="text-ink-light mb-6 leading-relaxed">{product.shortDescription}</p>
            )}

            {product.price != null && (
              <p class="text-3xl font-bold text-ink mb-6">${product.price.toFixed(2)}</p>
            )}

            {product.affiliateUrl && (
              <a
                href={product.affiliateUrl}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="inline-flex items-center justify-center gap-2 bg-brand-800 hover:bg-brand-900 text-white font-semibold py-3.5 px-8 rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-brand-200 text-lg"
              >
                Check Price on Amazon →
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Pros & Cons -->
      {(product.pros?.length || product.cons?.length) && (
        <div class="grid md:grid-cols-2 gap-6 mt-8">
          {product.pros?.length && (
            <div class="bg-surface-raised rounded-2xl shadow-sm border border-gray-100 p-6">
              <h2 class="text-lg font-bold text-emerald-700 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-sm">✓</span>
                What We Love
              </h2>
              <ul class="space-y-2.5">
                {product.pros.map((pro) => (
                  <li class="flex items-start gap-2.5 text-ink-light">
                    <span class="text-emerald-500 mt-0.5 shrink-0 font-bold">+</span>
                    {pro.point}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {product.cons?.length && (
            <div class="bg-surface-raised rounded-2xl shadow-sm border border-gray-100 p-6">
              <h2 class="text-lg font-bold text-red-700 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center text-sm">✗</span>
                Watch Out For
              </h2>
              <ul class="space-y-2.5">
                {product.cons.map((con) => (
                  <li class="flex items-start gap-2.5 text-ink-light">
                    <span class="text-red-500 mt-0.5 shrink-0 font-bold">−</span>
                    {con.point}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      <!-- Full Review Body -->
      {product.reviewBody && (
        <article class="bg-surface-raised rounded-2xl shadow-sm border border-gray-100 p-8 md:p-10 mt-8">
          <div class="prose prose-lg max-w-none
            prose-headings:text-ink prose-headings:font-bold
            prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4
            prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3
            prose-p:text-ink-light prose-p:leading-relaxed prose-p:mb-4
            prose-strong:text-ink
            prose-a:text-brand-800 prose-a:underline hover:prose-a:text-brand-600"
            set:html={product.reviewBody}
          />
        </article>
      )}

      <!-- CTA Section -->
      {product.affiliateUrl && (
        <div class="bg-brand-950 rounded-2xl p-8 md:p-10 mt-8 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">
            Ready to Buy the {product.name}?
          </h2>
          <p class="text-teal-200 mb-6 max-w-xl mx-auto">
            Get the best price and free shipping. We earn a small commission at no extra cost to you — it helps us keep reviewing products!
          </p>
          <a
            href={product.affiliateUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="inline-flex items-center justify-center gap-2 bg-white text-brand-800 font-bold py-4 px-10 rounded-2xl text-lg transition-all duration-200 hover:shadow-2xl hover:shadow-white/20 hover:scale-105"
          >
            Check Price on Amazon →
          </a>
          {product.price != null && (
            <p class="text-teal-300 text-sm mt-4">Current price: ${product.price.toFixed(2)}</p>
          )}
        </div>
      )}

      <!-- CMS Reviews -->
      {reviews.length > 0 && (
        <div class="mt-10">
          <h2 class="text-2xl font-bold text-ink mb-6">Community Reviews</h2>
          <div class="space-y-4">
            {reviews.map((review) => (
              <div class="bg-surface-raised rounded-2xl shadow-sm border border-gray-100 p-6">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <h3 class="text-lg font-semibold text-ink">{review.title}</h3>
                    {review.author && (
                      <p class="text-sm text-ink-muted">by {review.author}</p>
                    )}
                  </div>
                  {review.overallRating != null && (
                    <span class="text-amber-500 font-medium">{renderStars(review.overallRating)}</span>
                  )}
                </div>
                {review.summary && (
                  <p class="text-ink-light leading-relaxed">{review.summary}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-ink py-10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <Logo width={120} height={30} variant="white" />
      <p class="text-gray-500 text-xs">
        Affiliate Disclosure: We may earn commissions from qualifying purchases.
      </p>
    </div>
  </footer>
</Layout>
