</style>

<script>
  import { TRAIT_LABELS } from '../lib/traits';

  interface QuizOption {
    label: string;
    value: string;
    emoji?: string;
    description?: string;
  }
  interface QuizQuestion {
    key: string;
    question: string;
    helper?: string;
    emoji?: string;
    type: 'single' | 'multi' | 'text';
    layout: 'grid' | 'list' | 'scale';
    petScope: 'both' | 'dog' | 'cat';
    required: boolean;
    maxSelections?: number;
    placeholder?: string;
    options: QuizOption[];
  }
  interface QuizData {
    questions: QuizQuestion[];
    petTypes: ('dog' | 'cat')[];
    apiUrl: string;
  }
  interface MatchResult {
    id: number | string;
    name: string;
    slug: string;
    matchScore: number;
    headline: string;
    why: string[];
    watchOut: string;
    dayInTheLife?: string;
    size?: string;
    breedGroup?: string;
    origin?: string;
    shortDescription?: string;
    lifeExpectancyMin?: number;
    lifeExpectancyMax?: number;
    imageFilename?: string | null;
    imageAlt?: string;
    temperament?: string[];
    traits?: Record<string, number>;
  }
  interface MatchPayload {
    profileLabel: string;
    summary: string;
    tips: string[];
    matchedBy: 'ai' | 'fallback';
    matches: MatchResult[];
    subscribed?: boolean;
  }

  const dataEl = document.getElementById('quiz-data');
  if (dataEl) {
    const DATA: QuizData = JSON.parse(dataEl.textContent || '{}');
    const STORAGE_KEY = 'pawlabs-quiz-v1';
    const RESULT_KEY = 'pawlabs-quiz-result-v1';

    type PetType = 'dog' | 'cat' | 'either';
    type Stage = 'intro' | 'pet' | 'question' | 'email' | 'loading' | 'results';

    const state = {
      stage: 'intro' as Stage,
      petType: null as PetType | null,
      index: 0,
      answers: {} as Record<string, string[]>,
      email: '',
      // Opt-in, never opt-out: this only becomes true if the reader ticks the box.
      consent: false,
    };

    /* ── Elements ─────────────────────────────────── */
    const screens: Record<string, HTMLElement | null> = {
      intro: document.getElementById('screen-intro'),
      pet: document.getElementById('screen-pet'),
      question: document.getElementById('screen-question'),
      email: document.getElementById('screen-email'),
      loading: document.getElementById('screen-loading'),
      results: document.getElementById('screen-results'),
    };
    const progressEl = document.getElementById('quiz-progress')!;
    const progressTrack = document.getElementById('quiz-progress-track')!;
    const progressLabel = document.getElementById('quiz-progress-label')!;
    const backBtn = document.getElementById('quiz-back') as HTMLButtonElement;
    const questionMount = document.getElementById('question-mount')!;
    const resultsMount = document.getElementById('results-mount')!;

    const track = (event: string, params: Record<string, unknown> = {}) => {
      (window as any).gtag?.('event', event, params);
    };

    /* ── Question flow ────────────────────────────── */
    const activeQuestions = (): QuizQuestion[] => {
      if (!state.petType) return [];
      if (state.petType === 'either') return DATA.questions.filter((q) => q.petScope === 'both');
      return DATA.questions.filter((q) => q.petScope === 'both' || q.petScope === state.petType);
    };

    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
      );

    /* ── Screen transitions ───────────────────────── */
    let transitioning = false;

    function show(stage: Stage, back = false) {
      if (transitioning || state.stage === stage) {
        if (state.stage === stage) render(stage);
        return;
      }
      const current = screens[state.stage];
      const next = screens[stage];
      if (!next) return;

      transitioning = true;
      state.stage = stage;
      render(stage);

      if (current && current !== next) {
        current.classList.remove('is-active');
        current.classList.add('is-leaving');
        window.setTimeout(() => current.classList.remove('is-leaving'), 220);
      }

      window.setTimeout(
        () => {
          next.classList.toggle('is-back', back);
          next.classList.add('is-active');
          transitioning = false;
          updateChrome();
          const heading = next.querySelector('h1, h2');
          (heading as HTMLElement | null)?.setAttribute('tabindex', '-1');
          (heading as HTMLElement | null)?.focus?.();
          if (stage !== 'results') window.scrollTo({ top: 0, behavior: 'smooth' });
        },
        current && current !== next ? 200 : 0,
      );
    }

    function render(stage: Stage) {
      if (stage === 'question') renderQuestion();
    }

    function updateChrome() {
      const inFlow = state.stage === 'pet' || state.stage === 'question';
      progressEl.hidden = !inFlow;
      if (!inFlow) return;

      const questions = activeQuestions();
      const total = questions.length + 1; // + the pet type step
      const step = state.stage === 'pet' ? 1 : state.index + 2;
      const pct = Math.round(((step - 1) / total) * 100);

      progressTrack.style.setProperty('--quiz-progress', `${pct}%`);
      progressTrack.setAttribute('aria-valuenow', String(pct));
      progressLabel.textContent = `${step} / ${total}`;
      backBtn.disabled = state.stage === 'pet';
    }

    /* ── Persistence ──────────────────────────────── */
    function save() {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            petType: state.petType,
            index: state.index,
            answers: state.answers,
            at: Date.now(),
          }),
        );
      } catch {
        /* storage disabled — the quiz still works, it just won't resume */
      }
    }

    function clearSaved() {
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {
        /* ignore */
      }
    }

    function loadSaved() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        // A week-old half-finished quiz is not worth resuming.
        if (!parsed?.petType || Date.now() - (parsed.at ?? 0) > 7 * 864e5) return null;
        if (!Object.keys(parsed.answers ?? {}).length) return null;
        return parsed as { petType: PetType; index: number; answers: Record<string, string[]> };
      } catch {
        return null;
      }
    }

    /* ── Question rendering ───────────────────────── */
    function renderQuestion() {
      const questions = activeQuestions();
      const q = questions[state.index];
      if (!q) return;

      const selected = state.answers[q.key] ?? [];

      const optionsHtml = q.options
        .map((opt, i) => {
          const isSelected = selected.includes(opt.value);
          return `
            <button class="quiz-option${isSelected ? ' is-selected' : ''}" type="button"
              data-value="${escapeHtml(opt.value)}"
              role="${q.type === 'multi' ? 'checkbox' : 'radio'}"
              aria-checked="${isSelected}">
              <span class="quiz-option-key">${i + 1}</span>
              ${opt.emoji ? `<span class="quiz-option-emoji">${escapeHtml(opt.emoji)}</span>` : ''}
              <span class="quiz-option-body">
                <span class="quiz-option-label">${escapeHtml(opt.label)}</span>
                ${opt.description ? `<span class="quiz-option-desc">${escapeHtml(opt.description)}</span>` : ''}
              </span>
              <span class="quiz-option-check" aria-hidden="true">✓</span>
            </button>`;
        })
        .join('');

      const body =
        q.type === 'text'
          ? `<textarea class="quiz-textarea" id="quiz-text-input" placeholder="${escapeHtml(
              q.placeholder ?? 'Tell us anything else…',
            )}">${escapeHtml(selected[0] ?? '')}</textarea>
             <div class="quiz-actions">
               <span class="quiz-actions-hint">Optional — but it makes the match sharper.</span>
               <button class="quiz-continue" type="button" id="quiz-next">Continue →</button>
             </div>`
          : `<div class="quiz-options quiz-options-${q.layout}" id="quiz-options" role="${
              q.type === 'multi' ? 'group' : 'radiogroup'
            }" aria-label="${escapeHtml(q.question)}">${optionsHtml}</div>
             ${
               q.type === 'multi'
                 ? `<div class="quiz-actions">
                      <span class="quiz-actions-hint" id="quiz-multi-hint"></span>
                      <button class="quiz-continue" type="button" id="quiz-next">Continue →</button>
                    </div>`
                 : ''
             }`;

      questionMount.innerHTML = `
        <div class="quiz-q-head">
          <span class="quiz-q-emoji">${escapeHtml(q.emoji ?? '❓')}</span>
          <h2 class="quiz-q-title">${escapeHtml(q.question)}</h2>
          ${q.helper ? `<p class="quiz-q-helper">${escapeHtml(q.helper)}</p>` : ''}
        </div>
        ${body}`;

      wireQuestion(q);
    }

    function wireQuestion(q: QuizQuestion) {
      // Present for free-text and multi-select questions — both need an
      // explicit continue, since neither can auto-advance on a single tap.
      const nextBtn = document.getElementById('quiz-next') as HTMLButtonElement | null;
      nextBtn?.addEventListener('click', () => advance());

      if (q.type === 'text') {
        const input = document.getElementById('quiz-text-input') as HTMLTextAreaElement;
        input.addEventListener('input', () => {
          const value = input.value.trim();
          if (value) state.answers[q.key] = [value.slice(0, 800)];
          else delete state.answers[q.key];
          save();
        });
        window.setTimeout(() => input.focus(), 300);
        return;
      }

      const updateMulti = () => {
        const chosen = state.answers[q.key] ?? [];
        const hint = document.getElementById('quiz-multi-hint');
        if (hint) {
          const max = q.maxSelections;
          hint.textContent = chosen.length
            ? `${chosen.length} selected${max ? ` · up to ${max}` : ''}`
            : max
              ? `Pick up to ${max}`
              : 'Pick everything that applies';
        }
        if (nextBtn) nextBtn.disabled = q.required && chosen.length === 0;
      };

      document.querySelectorAll<HTMLButtonElement>('#quiz-options .quiz-option').forEach((btn) => {
        btn.addEventListener('click', () => {
          const value = btn.dataset.value!;
          if (q.type === 'multi') {
            const chosen = state.answers[q.key] ?? [];
            const at = chosen.indexOf(value);
            if (at >= 0) chosen.splice(at, 1);
            else if (!q.maxSelections || chosen.length < q.maxSelections) chosen.push(value);
            else return;
            state.answers[q.key] = chosen;
            btn.classList.toggle('is-selected', chosen.includes(value));
            btn.setAttribute('aria-checked', String(chosen.includes(value)));
            save();
            updateMulti();
          } else {
            state.answers[q.key] = [value];
            document.querySelectorAll('#quiz-options .quiz-option').forEach((el) => {
              el.classList.remove('is-selected');
              el.setAttribute('aria-checked', 'false');
            });
            btn.classList.add('is-selected');
            btn.setAttribute('aria-checked', 'true');
            save();
            // A beat so the selection registers visually before moving on.
            window.setTimeout(() => advance(), 260);
          }
        });
      });

      if (q.type === 'multi') updateMulti();
    }

    /* ── Navigation ───────────────────────────────── */
    function advance() {
      const questions = activeQuestions();
      track('quiz_question', { question_key: questions[state.index]?.key, step: state.index + 1 });

      if (state.index < questions.length - 1) {
        state.index += 1;
        save();
        renderQuestion();
        updateChrome();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }
      show('email');
    }

    function goBack() {
      if (state.stage === 'email') {
        state.index = Math.max(0, activeQuestions().length - 1);
        show('question', true);
        return;
      }
      if (state.stage !== 'question') return;
      if (state.index === 0) {
        show('pet', true);
        return;
      }
      state.index -= 1;
      save();
      renderQuestion();
      updateChrome();
    }

    backBtn.addEventListener('click', goBack);

    /* ── Intro ────────────────────────────────────── */
    document.getElementById('quiz-start')!.addEventListener('click', () => {
      track('quiz_start');
      show('pet');
    });

    const saved = loadSaved();
    if (saved) {
      const resumeEl = document.getElementById('quiz-resume')!;
      resumeEl.hidden = false;
      document.getElementById('quiz-resume-btn')!.addEventListener('click', () => {
        state.petType = saved.petType;
        state.answers = saved.answers;
        state.index = Math.min(saved.index ?? 0, Math.max(0, activeQuestions().length - 1));
        track('quiz_resume');
        show('question');
      });
    }

    /* ── Pet type ─────────────────────────────────── */
    document.querySelectorAll<HTMLButtonElement>('#pet-options .quiz-option-pet').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pet = btn.dataset.pet as PetType;
        // Changing species changes which questions apply, so start clean.
        if (state.petType && state.petType !== pet) state.answers = {};
        state.petType = pet;
        state.index = 0;
        document.querySelectorAll('#pet-options .quiz-option-pet').forEach((el) => {
          el.classList.remove('is-selected');
          el.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-checked', 'true');
        save();
        track('quiz_pet_type', { pet_type: pet });
        window.setTimeout(() => show('question'), 260);
      });
    });

    // Single available pet type still needs one tap, but pre-select it.
    if (DATA.petTypes.length === 1) state.petType = DATA.petTypes[0];

    /* ── Email step ───────────────────────────────── */
    const emailForm = document.getElementById('quiz-email-form') as HTMLFormElement;
    const emailInput = document.getElementById('quiz-email') as HTMLInputElement;
    const consentInput = document.getElementById('quiz-consent') as HTMLInputElement;
    const emailError = document.getElementById('quiz-email-error') as HTMLElement;

    emailForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        emailError.textContent = 'That email doesn’t look right — or skip this step.';
        emailError.hidden = false;
        emailInput.focus();
        return;
      }
      if (!consentInput.checked) {
        emailError.textContent = 'Tick the box so we’re allowed to email you — or skip this step.';
        emailError.hidden = false;
        consentInput.focus();
        return;
      }
      emailError.hidden = true;
      state.email = email;
      state.consent = true;
      track('quiz_email', { consent: true });
      submit();
    });

    document.getElementById('quiz-email-skip')!.addEventListener('click', () => {
      state.email = '';
      state.consent = false;
      track('quiz_email_skip');
      submit();
    });

    /* ── Submit ───────────────────────────────────── */
    const LOADING_STATUS = [
      'Reading your answers',
      'Scoring every breed we’ve profiled',
      'Weighing energy, grooming and temperament',
      'Throwing out the ones that would make you miserable',
      'Writing your match',
    ];

    async function submit() {
      show('loading');

      const questions = activeQuestions();
      const noteQuestion = questions.find((q) => q.type === 'text');
      const note = noteQuestion ? (state.answers[noteQuestion.key] ?? [])[0] ?? '' : '';

      const answers = Object.entries(state.answers)
        .filter(([key]) => questions.some((q) => q.key === key))
        .map(([key, value]) => ({ key, value }));

      // Status ticker + a progress bar that eases toward 90% while we wait.
      let statusAt = 0;
      const fill = document.getElementById('quiz-loading-fill')!;
      const status = document.getElementById('quiz-loading-status')!;
      status.textContent = LOADING_STATUS[0];
      let progress = 8;
      fill.style.width = '8%';
      const ticker = window.setInterval(() => {
        statusAt = Math.min(statusAt + 1, LOADING_STATUS.length - 1);
        status.textContent = LOADING_STATUS[statusAt];
        progress = Math.min(progress + 18, 90);
        fill.style.width = `${progress}%`;
      }, 2200);

      try {
        const res = await fetch(DATA.apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            petType: state.petType ?? 'either',
            answers,
            note,
            email: state.email || undefined,
            consent: state.consent,
            source: 'quiz-page',
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'We could not build your match.');

        window.clearInterval(ticker);
        fill.style.width = '100%';

        try {
          sessionStorage.setItem(RESULT_KEY, JSON.stringify(data));
        } catch {
          /* ignore */
        }
        clearSaved();
        track('quiz_complete', {
          top_breed: data.matches?.[0]?.name,
          matched_by: data.matchedBy,
          pet_type: state.petType,
        });

        window.setTimeout(() => renderResults(data as MatchPayload), 450);
      } catch (err) {
        window.clearInterval(ticker);
        renderError((err as Error).message);
      }
    }

    /* ── Results ──────────────────────────────────── */
    const RESULT_TRAITS = [
      'energyLevel',
      'affectionLevel',
      'trainability',
      'groomingNeeds',
      'childFriendly',
      'adaptability',
    ];

    // Media filenames in the CMS can contain spaces (and sometimes no extension),
    // so the path segment has to be encoded.
    const mediaHtml = (m: MatchResult, emoji: string) =>
      m.imageFilename
        ? `<img src="/media/${escapeHtml(encodeURIComponent(m.imageFilename))}" alt="${escapeHtml(
            m.imageAlt ?? m.name,
          )}" loading="lazy" />`
        : `<div class="quiz-top-media-empty">${emoji}</div>`;

    function renderResults(data: MatchPayload) {
      const [top, ...runners] = data.matches ?? [];
      if (!top) {
        renderError('We could not build your match. Please try again.');
        return;
      }

      const circumference = 2 * Math.PI * 32;
      const offset = circumference * (1 - Math.min(top.matchScore, 100) / 100);

      const tags = [top.size, top.breedGroup, top.origin]
        .filter(Boolean)
        .map((t) => `<span class="quiz-tag">${escapeHtml(String(t).replace(/-/g, ' '))}</span>`)
        .join('');

      const traits = RESULT_TRAITS.filter((key) => typeof top.traits?.[key] === 'number')
        .map((key) => {
          const value = Math.max(1, Math.min(10, top.traits![key]));
          return `
            <div>
              <div class="quiz-trait-label"><span>${escapeHtml(TRAIT_LABELS[key] ?? key)}</span><span>${value}/10</span></div>
              <div class="quiz-trait-bar"><div class="quiz-trait-fill" data-width="${value * 10}"></div></div>
            </div>`;
        })
        .join('');

      const runnersHtml = runners
        .map(
          (m) => `
        <a class="quiz-runner" href="/breeds/${escapeHtml(m.slug)}">
          <div class="quiz-runner-media">
            ${mediaHtml(m, '🐾')}
            <span class="quiz-runner-score">${m.matchScore}%</span>
          </div>
          <div class="quiz-runner-body">
            <span class="quiz-runner-name">${escapeHtml(m.name)}</span>
            <p class="quiz-runner-text">${escapeHtml(m.headline || m.shortDescription || '')}</p>
            <span class="quiz-runner-link">Read the profile →</span>
          </div>
        </a>`,
        )
        .join('');

      const tipsHtml = (data.tips ?? [])
        .map((tip, i) => `<div class="quiz-tip"><span>${i + 1}</span><p>${escapeHtml(tip)}</p></div>`)
        .join('');

      // Every network points at the same stable result page, which is what
      // carries the og tags and the share card.
      const resultUrl = `${window.location.origin}/quiz/result/${top.slug}`;
      const cardUrl = `${window.location.origin}/share/${top.slug}.jpg`;
      const shareText = `My perfect dog breed is the ${top.name}! 🐾 Find yours with the PawLabs breed quiz:`;
      const e = encodeURIComponent;
      const shareTargets = [
        { key: 'x', label: 'X', href: `https://twitter.com/intent/tweet?text=${e(shareText)}&url=${e(resultUrl)}` },
        { key: 'facebook', label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${e(resultUrl)}` },
        { key: 'whatsapp', label: 'WhatsApp', href: `https://api.whatsapp.com/send?text=${e(`${shareText} ${resultUrl}`)}` },
        { key: 'pinterest', label: 'Pinterest', href: `https://pinterest.com/pin/create/button/?url=${e(resultUrl)}&description=${e(shareText)}&media=${e(cardUrl)}` },
      ];

      resultsMount.innerHTML = `
        <div class="quiz-results">
          <div class="quiz-result-head">
            ${data.profileLabel ? `<div class="quiz-profile-chip">🐾 ${escapeHtml(data.profileLabel)}</div>` : ''}
            <h2 class="quiz-result-title">Your match is the ${escapeHtml(top.name)}</h2>
            ${data.summary ? `<p class="quiz-result-summary">${escapeHtml(data.summary)}</p>` : ''}
          </div>

          <div class="quiz-top-card">
            <div class="quiz-top-media">
              ${mediaHtml(top, '🐶')}
              <div class="quiz-top-overlay">
                <div>
                  <div class="quiz-top-name">${escapeHtml(top.name)}</div>
                  <div class="quiz-top-meta">${tags}</div>
                </div>
                <div class="quiz-ring" style="--quiz-circ:${circumference};--quiz-offset:${offset}">
                  <svg viewBox="0 0 72 72" aria-hidden="true">
                    <circle class="quiz-ring-bg" cx="36" cy="36" r="32"></circle>
                    <circle class="quiz-ring-fg" cx="36" cy="36" r="32"></circle>
                  </svg>
                  <div class="quiz-ring-value"><strong>${top.matchScore}%</strong><span>match</span></div>
                </div>
              </div>
            </div>

            <div class="quiz-top-body">
              ${top.headline ? `<p class="quiz-headline">${escapeHtml(top.headline)}</p>` : ''}
              <div class="quiz-why">${top.why.map((w) => `<p>${escapeHtml(w)}</p>`).join('')}</div>
              ${
                top.dayInTheLife
                  ? `<div class="quiz-callout quiz-callout-day"><strong>A normal Tuesday</strong>${escapeHtml(top.dayInTheLife)}</div>`
                  : ''
              }
              ${
                top.watchOut
                  ? `<div class="quiz-callout quiz-callout-warn"><strong>Worth knowing</strong>${escapeHtml(top.watchOut)}</div>`
                  : ''
              }
              ${traits ? `<div class="quiz-traits">${traits}</div>` : ''}
              <a class="quiz-result-cta" href="/breeds/${escapeHtml(top.slug)}">Read the full ${escapeHtml(top.name)} profile →</a>
            </div>
          </div>

          ${runnersHtml ? `<div class="quiz-runners">${runnersHtml}</div>` : ''}
          ${tipsHtml ? `<div class="quiz-panel"><h3>What to do next</h3><div class="quiz-tips">${tipsHtml}</div></div>` : ''}
          ${
            data.subscribed
              ? `<div class="quiz-panel"><h3>Check your inbox 📬</h3><p class="quiz-runner-text">Your match is on its way, along with a weekly breed profile. Unsubscribe in one click, any time.</p></div>`
              : ''
          }

          <div class="quiz-panel quiz-share-panel">
            <h3>Share my match</h3>
            <p class="quiz-share-note">Everyone lands on your result page, not a blank quiz.</p>
            <div class="quiz-share-row">
              <button class="quiz-ghost-btn" type="button" id="quiz-share">🔗 Copy link</button>
              ${shareTargets
                .map(
                  (t) =>
                    `<a class="quiz-ghost-btn" href="${escapeHtml(t.href)}" target="_blank" rel="noopener noreferrer" data-share="${t.key}">${t.label}</a>`,
                )
                .join('')}
            </div>
          </div>

          <div class="quiz-result-actions">
            <a class="quiz-ghost-btn" href="/quiz/result/${escapeHtml(top.slug)}">🔗 View my result page</a>
            ${runners.length ? `<a class="quiz-ghost-btn" href="/compare">⚖️ Compare these breeds</a>` : ''}
            <button class="quiz-ghost-btn" type="button" id="quiz-retake">↻ Take it again</button>
          </div>

          ${
            data.matchedBy === 'fallback'
              ? `<p class="quiz-fallback-note">Our AI writer was unavailable, so this match came straight from trait scoring. The breeds are still ranked against your answers.</p>`
              : ''
          }
        </div>`;

      show('results');

      window.requestAnimationFrame(() => {
        document.querySelectorAll<HTMLElement>('.quiz-trait-fill').forEach((el) => {
          el.style.width = `${el.dataset.width}%`;
        });
      });

      document.getElementById('quiz-retake')?.addEventListener('click', () => {
        state.answers = {};
        state.index = 0;
        state.petType = null;
        state.email = '';
        clearSaved();
        try {
          sessionStorage.removeItem(RESULT_KEY);
        } catch {
          /* ignore */
        }
        document.querySelectorAll('#pet-options .quiz-option-pet').forEach((el) => {
          el.classList.remove('is-selected');
          el.setAttribute('aria-checked', 'false');
        });
        show('pet');
      });

      document.getElementById('quiz-share')?.addEventListener('click', async () => {
        const btn = document.getElementById('quiz-share')!;
        const confirmCopied = () => {
          btn.textContent = '✓ Copied!';
          window.setTimeout(() => {
            btn.textContent = '🔗 Copy link';
          }, 2000);
        };

        try {
          if (navigator.share) {
            await navigator.share({
              title: 'PawLabs Breed Match',
              text: shareText,
              url: resultUrl,
            });
          } else {
            // clipboard API needs a secure context — fall back if unavailable.
            await navigator.clipboard.writeText(resultUrl);
            confirmCopied();
          }
          track('quiz_share', { method: 'native_or_copy', breed: top.name });
        } catch (err) {
          // AbortError just means the user dismissed the share sheet.
          if ((err as Error)?.name === 'AbortError') return;
          window.prompt('Copy this link:', resultUrl);
        }
      });

      document.querySelectorAll<HTMLAnchorElement>('.quiz-share-row a[data-share]').forEach((link) => {
        link.addEventListener('click', () => {
          track('quiz_share', { method: link.dataset.share, breed: top.name });
        });
      });

      celebrate();
    }

    function renderError(message: string) {
      resultsMount.innerHTML = `
        <div class="quiz-error">
          <h2>That didn't work</h2>
          <p>${escapeHtml(message)}</p>
          <button class="quiz-cta" type="button" id="quiz-retry">Try again</button>
        </div>`;
      show('results');
      document.getElementById('quiz-retry')?.addEventListener('click', () => submit());
    }

    /* ── Confetti ─────────────────────────────────── */
    function celebrate() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const canvas = document.getElementById('quiz-confetti') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const dpr = window.devicePixelRatio || 1;
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx.scale(dpr, dpr);
      canvas.classList.add('is-on');

      const colors = ['#3ABF8E', '#C2F030', '#207A5B', '#93EAC7', '#D4FF59'];
      const pieces = Array.from({ length: 110 }, () => ({
        x: Math.random() * window.innerWidth,
        y: -20 - Math.random() * window.innerHeight * 0.5,
        w: 6 + Math.random() * 7,
        h: 8 + Math.random() * 10,
        vy: 2.2 + Math.random() * 3.2,
        vx: -1.2 + Math.random() * 2.4,
        rot: Math.random() * Math.PI,
        vr: -0.12 + Math.random() * 0.24,
        color: colors[Math.floor(Math.random() * colors.length)],
      }));

      const start = performance.now();
      const tick = (now: number) => {
        const elapsed = now - start;
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        const fade = elapsed > 2600 ? Math.max(0, 1 - (elapsed - 2600) / 900) : 1;

        for (const p of pieces) {
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vr;
          ctx.save();
          ctx.globalAlpha = fade;
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        }

        if (elapsed < 3600) {
          window.requestAnimationFrame(tick);
        } else {
          ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
          canvas.classList.remove('is-on');
        }
      };
      window.requestAnimationFrame(tick);
    }

    /* ── Keyboard ─────────────────────────────────── */
    document.addEventListener('keydown', (e) => {
      if (state.stage !== 'question' && state.stage !== 'pet') return;
      const target = e.target as HTMLElement;
      if (target.tagName === 'TEXTAREA' || target.tagName === 'INPUT') return;

      if (e.key === 'Backspace' || e.key === 'ArrowLeft') {
        e.preventDefault();
        goBack();
        return;
      }

      const container =
        state.stage === 'pet'
          ? document.getElementById('pet-options')
          : document.getElementById('quiz-options');
      const options = container?.querySelectorAll<HTMLButtonElement>('.quiz-option');
      if (!options?.length) return;

      if (/^[1-9]$/.test(e.key)) {
        const index = Number(e.key) - 1;
        if (options[index]) {
          e.preventDefault();
          options[index].click();
        }
        return;
      }

      if (e.key === 'Enter') {
        const next = document.getElementById('quiz-next') as HTMLButtonElement | null;
        if (next && !next.disabled) {
          e.preventDefault();
          next.click();
        }
      }
    });

    /* ── Deep link: /quiz#start ───────────────────── */
    if (window.location.hash === '#start') {
      track('quiz_start', { via: 'deep-link' });
      show('pet');
    }
  }
</script>
