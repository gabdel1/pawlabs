---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getBreeds } from '../lib/payload';
import { getQuizQuestions, questionsForPetType, quizLength, QUIZ_API_URL } from '../lib/quiz';
import { quizJsonLd, breadcrumbJsonLd } from '../lib/seo';
import { Sparkles, ArrowRight, ArrowLeft, Check, PawPrint, Timer, Brain } from 'lucide-astro';

const [breeds, questions] = await Promise.all([getBreeds(), getQuizQuestions()]);

// Only offer a pet type we can actually match against.
const petTypesAvailable = (['dog', 'cat'] as const).filter(
  (t) => breeds.some((b) => b.petType === t) && questionsForPetType(questions, t).length > 0,
);

const questionCount = quizLength(questions);
const breedCount = breeds.length;

const quizData = {
  questions,
  petTypes: petTypesAvailable,
  apiUrl: QUIZ_API_URL,
};

// Embedded as JSON rather than define:vars so a stray quote in CMS copy
// can never break the page script.
const quizDataJson = JSON.stringify(quizData).replace(/</g, '\\u003c');

const petCopy: Record<string, { emoji: string; label: string; blurb: string }> = {
  dog: { emoji: '🐕', label: 'A dog', blurb: 'Walks, training, a shadow at your feet' },
  cat: { emoji: '🐈', label: 'A cat', blurb: 'Independent, clever, on their own terms' },
};
---

<Layout
  title="Breed Match Quiz — Find the Right Breed For Your Life | PawLabs"
  description={`Answer ${questionCount} honest questions about your home, your week and your household. Our AI reads your answers against ${breedCount} breed profiles and tells you which breeds actually fit — and which to avoid.`}
  canonicalUrl="/quiz"
  ogType="website"
  jsonLd={[quizJsonLd(questionCount, breedCount), breadcrumbJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Breed Match Quiz', url: '/quiz' },
  ])]}
>
  <Nav activePage="quiz" />

  <main class="quiz-page">
    <div class="quiz-bg" aria-hidden="true">
      <div class="quiz-orb quiz-orb-a"></div>
      <div class="quiz-orb quiz-orb-b"></div>
      <div class="quiz-orb quiz-orb-c"></div>
    </div>

    <div class="quiz-shell">
      <!-- ── Progress rail ─────────────────────────────── -->
      <div class="quiz-progress" id="quiz-progress" hidden>
        <button class="quiz-back" id="quiz-back" type="button" aria-label="Previous question">
          <ArrowLeft class="w-4 h-4" />
        </button>
        <div class="quiz-progress-track" id="quiz-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
        <span class="quiz-progress-label" id="quiz-progress-label">1 / {questionCount}</span>
      </div>

      <!-- ── Intro ─────────────────────────────────────── -->
      <section class="quiz-screen is-active" id="screen-intro">
        <div class="quiz-intro">
          <div class="quiz-badge">
            <Sparkles class="w-4 h-4" />
            <span>AI breed matching · about 2 minutes</span>
          </div>

          <h1 class="quiz-title">
            Which breed actually
            <span class="quiz-title-accent">fits your life?</span>
          </h1>

          <p class="quiz-lede">
            Not the breed you like the look of. The one that fits your flat, your week, your
            patience and your vacuum cleaner. {questionCount} honest questions — then we read your answers
            against every breed we've profiled.
          </p>

          <div class="quiz-stats">
            <div class="quiz-stat">
              <PawPrint class="w-4 h-4" />
              <div><strong>{breedCount}</strong><span>breeds profiled</span></div>
            </div>
            <div class="quiz-stat">
              <Brain class="w-4 h-4" />
              <div><strong>14</strong><span>traits scored</span></div>
            </div>
            <div class="quiz-stat">
              <Timer class="w-4 h-4" />
              <div><strong>2 min</strong><span>to your match</span></div>
            </div>
          </div>

          <button class="quiz-cta" id="quiz-start" type="button">
            Start the quiz
            <ArrowRight class="w-5 h-5" />
          </button>

          <p class="quiz-microcopy">Free. No signup needed to see your match.</p>

          <div class="quiz-resume" id="quiz-resume" hidden>
            <span>You left a quiz half-finished.</span>
            <button type="button" id="quiz-resume-btn">Pick up where you left off</button>
          </div>
        </div>
      </section>

      <!-- ── Pet type ──────────────────────────────────── -->
      <section class="quiz-screen" id="screen-pet">
        <div class="quiz-q-head">
          <span class="quiz-q-emoji">🐾</span>
          <h2 class="quiz-q-title">First — what are you looking for?</h2>
          <p class="quiz-q-helper">This decides which questions we ask next.</p>
        </div>

        <div class="quiz-options quiz-options-pet" id="pet-options" role="radiogroup" aria-label="Pet type">
          {petTypesAvailable.map((type, i) => (
            <button class="quiz-option quiz-option-pet" type="button" data-pet={type} role="radio" aria-checked="false">
              <span class="quiz-option-key">{i + 1}</span>
              <span class="quiz-option-emoji">{petCopy[type].emoji}</span>
              <span class="quiz-option-body">
                <span class="quiz-option-label">{petCopy[type].label}</span>
                <span class="quiz-option-desc">{petCopy[type].blurb}</span>
              </span>
            </button>
          ))}
          {petTypesAvailable.length > 1 && (
            <button class="quiz-option quiz-option-pet" type="button" data-pet="either" role="radio" aria-checked="false">
              <span class="quiz-option-key">{petTypesAvailable.length + 1}</span>
              <span class="quiz-option-emoji">🤷</span>
              <span class="quiz-option-body">
                <span class="quiz-option-label">Honestly, either</span>
                <span class="quiz-option-desc">Show me whatever fits best</span>
              </span>
            </button>
          )}
        </div>

        {petTypesAvailable.length === 1 && (
          <p class="quiz-note">
            We're matching {petTypesAvailable[0] === 'dog' ? 'dog' : 'cat'} breeds today — {petTypesAvailable[0] === 'dog' ? 'cat' : 'dog'} profiles are on the way.
          </p>
        )}
      </section>

      <!-- ── Questions (rendered by script) ────────────── -->
      <section class="quiz-screen" id="screen-question">
        <div id="question-mount"></div>
      </section>

      <!-- ── Email ─────────────────────────────────────── -->
      <section class="quiz-screen" id="screen-email">
        <div class="quiz-q-head">
          <span class="quiz-q-emoji">💌</span>
          <h2 class="quiz-q-title">Want your match in your inbox?</h2>
          <p class="quiz-q-helper">
            Tick the box and we'll send your result, plus one email a week: new breed profiles, care
            notes and the occasional genuinely good offer. Skip it and you'll still see your match on
            the next screen — nothing about your result changes.
          </p>
        </div>

        <form class="quiz-email-form" id="quiz-email-form" novalidate>
          <input
            type="email"
            id="quiz-email"
            class="quiz-email-input"
            placeholder="you@example.com"
            autocomplete="email"
            aria-label="Your email address"
          />
          <!--
            Deliberately NOT pre-checked. A pre-ticked box is not valid consent
            under GDPR (Art. 4(11); CJEU, Planet49 C-673/17), and the submit
            handler refuses an address unless it has been ticked, so the two
            cannot drift apart.
          -->
          <label class="quiz-consent">
            <input type="checkbox" id="quiz-consent" />
            <span>
              Yes — email me my match, plus weekly breed profiles, care notes and offers.
              Unsubscribe in one click. See our <a href="/privacy" target="_blank" rel="noopener">privacy policy</a>.
            </span>
          </label>
          <p class="quiz-email-error" id="quiz-email-error" hidden></p>
          <button class="quiz-cta" type="submit">
            See my match
            <ArrowRight class="w-5 h-5" />
          </button>
          <button class="quiz-skip" type="button" id="quiz-email-skip">Skip — just show me the result</button>
        </form>
      </section>

      <!-- ── Analysing ─────────────────────────────────── -->
      <section class="quiz-screen" id="screen-loading">
        <div class="quiz-loading">
          <div class="quiz-loader" aria-hidden="true">
            <span class="quiz-paw quiz-paw-1">🐾</span>
            <span class="quiz-paw quiz-paw-2">🐾</span>
            <span class="quiz-paw quiz-paw-3">🐾</span>
          </div>
          <h2 class="quiz-loading-title">Reading your answers…</h2>
          <p class="quiz-loading-status" id="quiz-loading-status">Warming up</p>
          <div class="quiz-loading-bar"><div class="quiz-loading-fill" id="quiz-loading-fill"></div></div>
        </div>
      </section>

      <!-- ── Results (rendered by script) ──────────────── -->
      <section class="quiz-screen" id="screen-results">
        <div id="results-mount"></div>
      </section>
    </div>

    <canvas id="quiz-confetti" aria-hidden="true"></canvas>
  </main>

  <Footer />
</Layout>

<script type="application/json" id="quiz-data" is:inline set:html={quizDataJson}></script>

<style is:global>
  /* ─── Breed Match quiz ─────────────────────────────────
     Namespaced .quiz-* so the runtime-rendered markup styles
     identically to the server-rendered screens. */

  .quiz-page {
    position: relative;
    min-height: 100svh;
    padding: clamp(6.5rem, 12vh, 9rem) 1rem clamp(3rem, 8vh, 6rem);
    overflow: hidden;
    background: linear-gradient(170deg, #FFFFFF 0%, #F2FDF8 45%, #E6FAEE 100%);
  }

  .quiz-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .quiz-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
    animation: quizFloat 14s ease-in-out infinite;
  }
  .quiz-orb-a { width: 34rem; height: 34rem; top: -10rem; left: -12rem; background: rgba(98, 215, 170, 0.35); }
  .quiz-orb-b { width: 28rem; height: 28rem; bottom: -8rem; right: -8rem; background: rgba(194, 240, 48, 0.28); animation-delay: -5s; }
  .quiz-orb-c { width: 22rem; height: 22rem; top: 40%; left: 55%; background: rgba(32, 122, 91, 0.18); animation-delay: -9s; }

  @keyframes quizFloat {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(0, -34px, 0) scale(1.06); }
  }

  .quiz-shell {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin: 0 auto;
  }

  /* ─── Screens ─────────────────────────────────────── */
  .quiz-screen { display: none; }
  .quiz-screen.is-active {
    display: block;
    animation: quizIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .quiz-screen.is-leaving {
    display: block;
    animation: quizOut 0.22s cubic-bezier(0.4, 0, 1, 1) both;
  }

  @keyframes quizIn {
    from { opacity: 0; transform: translateY(22px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }
  @keyframes quizOut {
    from { opacity: 1; transform: none; }
    to { opacity: 0; transform: translateY(-14px) scale(0.99); }
  }
  .quiz-screen.is-back.is-active { animation-name: quizInBack; }
  @keyframes quizInBack {
    from { opacity: 0; transform: translateY(-18px); }
    to { opacity: 1; transform: none; }
  }

  /* ─── Progress ────────────────────────────────────── */
  .quiz-progress {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }
  .quiz-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid rgba(10, 15, 26, 0.08);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    color: var(--color-ink);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, opacity 0.2s ease;
  }
  .quiz-back:hover { background: #fff; transform: translateX(-2px); }
  .quiz-back[disabled] { opacity: 0.3; cursor: default; transform: none; }

  .quiz-progress-track {
    position: relative;
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: rgba(10, 15, 26, 0.07);
    overflow: hidden;
  }
  .quiz-progress-track::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--quiz-progress, 0%);
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-brand-600), var(--color-accent-400));
    transition: width 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .quiz-progress-label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  /* ─── Intro ───────────────────────────────────────── */
  .quiz-intro { text-align: center; }

  .quiz-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 4px 20px -8px rgba(10, 15, 26, 0.12);
    color: var(--color-brand-700);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.75rem;
  }

  .quiz-title {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.02;
    font-size: clamp(2.4rem, 7vw, 4.25rem);
    color: var(--color-ink);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }
  .quiz-title-accent {
    display: block;
    background: linear-gradient(115deg, var(--color-brand-700), var(--color-brand-400) 55%, var(--color-accent-500));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .quiz-lede {
    max-width: 34rem;
    margin: 0 auto 2rem;
    font-size: clamp(1rem, 1.4vw + 0.6rem, 1.15rem);
    line-height: 1.65;
    color: var(--color-ink-muted);
    font-weight: 500;
    text-wrap: pretty;
  }

  .quiz-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2.25rem;
  }
  .quiz-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.1rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(10, 15, 26, 0.05);
    color: var(--color-brand-700);
  }
  .quiz-stat div { display: flex; flex-direction: column; line-height: 1.15; text-align: left; }
  .quiz-stat strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-ink);
  }
  .quiz-stat span { font-size: 0.7rem; font-weight: 600; color: var(--color-ink-muted); }

  .quiz-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 1.05rem 2.4rem;
    border: none;
    border-radius: 999px;
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 18px 36px -16px rgba(10, 15, 26, 0.55);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background 0.25s ease;
  }
  .quiz-cta:hover { transform: translateY(-3px); box-shadow: 0 24px 44px -16px rgba(10, 15, 26, 0.5); }
  .quiz-cta:active { transform: translateY(-1px); }
  .quiz-cta[disabled] { opacity: 0.45; cursor: not-allowed; transform: none; box-shadow: none; }

  .quiz-microcopy {
    margin-top: 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    opacity: 0.75;
  }

  .quiz-resume {
    margin-top: 2rem;
    padding: 0.9rem 1.2rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.8);
    border: 1px dashed rgba(32, 122, 91, 0.3);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    font-weight: 600;
  }
  .quiz-resume button {
    margin-left: 0.4rem;
    border: none;
    background: none;
    color: var(--color-brand-700);
    font-weight: 800;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── Question head ───────────────────────────────── */
  .quiz-q-head { text-align: center; margin-bottom: 1.75rem; }
  .quiz-q-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1.25rem;
    font-size: 1.7rem;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(10, 15, 26, 0.05);
    box-shadow: 0 10px 30px -14px rgba(10, 15, 26, 0.3);
    margin-bottom: 1rem;
    animation: quizPop 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes quizPop {
    from { opacity: 0; transform: scale(0.6) rotate(-12deg); }
    to { opacity: 1; transform: none; }
  }
  .quiz-q-title {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.12;
    font-size: clamp(1.6rem, 3.6vw, 2.35rem);
    color: var(--color-ink);
    text-wrap: balance;
  }
  .quiz-q-helper {
    margin-top: 0.7rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    font-weight: 500;
    max-width: 32rem;
    margin-inline: auto;
    text-wrap: pretty;
  }

  /* ─── Options ─────────────────────────────────────── */
  .quiz-options { display: grid; gap: 0.7rem; }
  .quiz-options-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .quiz-options-list, .quiz-options-pet { grid-template-columns: 1fr; }
  .quiz-options-scale { grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); }

  @media (max-width: 560px) {
    .quiz-options-grid, .quiz-options-scale { grid-template-columns: 1fr; }
  }

  .quiz-option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 1.05rem 1.15rem;
    border-radius: 1.15rem;
    border: 1.5px solid rgba(10, 15, 26, 0.07);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px);
    text-align: left;
    cursor: pointer;
    color: var(--color-ink);
    box-shadow: 0 2px 14px -8px rgba(10, 15, 26, 0.14);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease,
      box-shadow 0.25s ease, background 0.2s ease;
    animation: quizIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .quiz-option:nth-child(1) { animation-delay: 0.04s; }
  .quiz-option:nth-child(2) { animation-delay: 0.08s; }
  .quiz-option:nth-child(3) { animation-delay: 0.12s; }
  .quiz-option:nth-child(4) { animation-delay: 0.16s; }
  .quiz-option:nth-child(5) { animation-delay: 0.2s; }
  .quiz-option:nth-child(6) { animation-delay: 0.24s; }

  @media (hover: hover) {
    .quiz-option:hover {
      transform: translateY(-3px);
      border-color: rgba(58, 191, 142, 0.55);
      background: #fff;
      box-shadow: 0 16px 32px -18px rgba(32, 122, 91, 0.55);
    }
  }
  .quiz-option:focus-visible {
    outline: none;
    border-color: var(--color-brand-500);
    box-shadow: 0 0 0 4px rgba(98, 215, 170, 0.3);
  }
  .quiz-option.is-selected {
    border-color: var(--color-brand-600);
    background: linear-gradient(135deg, #fff, var(--color-brand-50));
    box-shadow: 0 14px 30px -16px rgba(32, 122, 91, 0.6);
  }
  .quiz-option.is-selected .quiz-option-key {
    background: var(--color-brand-600);
    border-color: var(--color-brand-600);
    color: #fff;
  }

  .quiz-option-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.55rem;
    border: 1px solid rgba(10, 15, 26, 0.1);
    background: rgba(10, 15, 26, 0.03);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--color-ink-muted);
    transition: all 0.2s ease;
  }
  @media (max-width: 640px) { .quiz-option-key { display: none; } }

  .quiz-option-emoji { font-size: 1.5rem; flex-shrink: 0; line-height: 1; }
  .quiz-option-body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .quiz-option-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .quiz-option-desc { font-size: 0.8rem; color: var(--color-ink-muted); font-weight: 500; line-height: 1.4; }

  .quiz-option-check {
    position: absolute;
    top: 0.6rem;
    right: 0.7rem;
    display: none;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--color-brand-600);
    color: #fff;
    font-size: 0.7rem;
    animation: quizPop 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .quiz-option.is-selected .quiz-option-check { display: flex; }

  /* Scale layout stacks the emoji above the label */
  .quiz-options-scale .quiz-option {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1.2rem 0.8rem;
  }
  .quiz-options-scale .quiz-option-body { align-items: center; text-align: center; }
