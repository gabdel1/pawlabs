---
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getGuides, getMediaUrl, CATEGORY_LABELS, GUIDE_TYPE_LABELS } from '../../lib/payload';
import type { Media } from '../../lib/payload';
import { ChevronRight, BookOpen, ArrowUpRight } from 'lucide-astro';

const guides = await getGuides();

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Guides' },
];
---

<Layout
  title="Expert Pet Guides - PawLabs"
  description="In-depth buying guides, product roundups, and comparison articles curated by our team of pet product experts."
  canonicalUrl="/guides"
  ogType="website"
>
  <!-- Floating Pill Navigation -->
  <nav class="fixed top-6 left-0 right-0 z-50 flex justify-center px-4 sm:px-6 pointer-events-none">
    <div class="glass-pill px-2 py-2 pr-3 sm:pr-6 rounded-full flex items-center justify-between w-full max-w-5xl pointer-events-auto">
      <div class="flex items-center gap-8 pl-4">
        <a href="/" class="hover:opacity-80 transition-opacity">
          <Logo width={130} height={32} />
        </a>
      </div>
      <div class="hidden md:flex items-center gap-8">
        <a href="/products" class="nav-link text-ink text-sm font-semibold tracking-wide">Products</a>
        <a href="/guides" class="nav-link text-brand-700 text-sm font-bold tracking-wide">Guides</a>
      </div>
      <div class="flex items-center gap-2">
        <a href="/products" class="btn-primary bg-ink text-white text-sm font-bold py-3 px-5 sm:px-7 rounded-full transition-transform hidden sm:inline-flex">
          Browse All
        </a>
        <button id="hamburger-btn" class="hamburger-btn md:hidden" aria-label="Open menu" aria-expanded="false">
          <svg class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div id="mobile-overlay" class="mobile-drawer-overlay"></div>
  <div id="mobile-drawer" class="mobile-drawer">
    <div class="flex items-center justify-between mb-4">
      <span class="font-display font-bold text-ink text-lg">Menu</span>
      <button id="drawer-close" class="hamburger-btn" aria-label="Close menu">
        <svg class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <a href="/products">📦 Products</a>
    <a href="/guides">📖 Guides</a>
    <a href="/compare">⚖️ Compare</a>
    <div class="mt-auto pt-6">
      <a href="/products" class="!bg-ink !text-white !rounded-full !justify-center !font-bold">Browse All</a>
    </div>
  </div>

  <main class="min-h-screen bg-surface noise pt-32 sm:pt-36">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <div class="mb-8 sm:mb-12 reveal">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <div class="mb-10 sm:mb-16 reveal reveal-delay-1">
        <h1 class="display-heading display-fluid-lg text-ink mb-3 sm:mb-4 text-balance">Expert Guides</h1>
        <p class="text-ink-muted text-base sm:text-lg max-w-2xl text-pretty font-medium">Comprehensive buying guides, curated roundups, and head-to-head comparisons — powered by real testing and honest opinions.</p>
      </div>

      {guides.length === 0 ? (
        <div class="text-center py-32 reveal flex flex-col items-center justify-center">
          <div class="w-24 h-24 rounded-[2rem] bg-brand-50 text-brand-400 flex items-center justify-center mb-6 border border-brand-100 shadow-xl shadow-brand-100/50">
            <BookOpen class="w-12 h-12" />
          </div>
          <p class="text-ink-muted text-xl mb-4 font-medium">Guides are on the way.</p>
          <p class="text-ink-muted text-base mb-8">Our team is working on comprehensive buying guides. Check back soon!</p>
          <a href="/products" class="btn-primary inline-flex items-center justify-center gap-2 bg-ink text-white font-bold py-4 px-10 rounded-full text-base transition-all duration-300">
            Browse Products <ChevronRight class="w-5 h-5" />
          </a>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 gap-8">
          {guides.map((guide, i) => {
            const typeLabel = guide.guideType ? GUIDE_TYPE_LABELS[guide.guideType] : null;
            const categoryLabel = guide.category ? CATEGORY_LABELS[guide.category] : null;
            const productCount = Array.isArray(guide.products) ? guide.products.length : 0;
            const publishDate = guide.publishedDate ? new Date(guide.publishedDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : null;
            const coverUrl = getMediaUrl(guide.featuredImage as Media);

            return (
              <a href={`/guides/${guide.slug}`} class={`card-hover group glass-card rounded-[2rem] overflow-hidden reveal reveal-delay-${Math.min((i % 2) + 1, 4)} border-transparent hover:border-brand-200 block`}>
                {coverUrl && (
                  <div class="w-full aspect-[7/3] overflow-hidden bg-surface">
                    <img
                      src={coverUrl}
                      alt={guide.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-8 bg-white">
                  <div class="flex flex-wrap gap-2 mb-4">
                    {typeLabel && (
                      <span class="badge bg-brand-50 text-brand-700 border border-brand-100 font-bold text-xs">
                        {typeLabel}
                      </span>
                    )}
                    {categoryLabel && (
                      <span class="badge bg-white text-ink-light border border-ink/10 text-xs">
                        {categoryLabel}
                      </span>
                    )}
                  </div>

                  <h2 class="font-display font-bold text-ink text-xl group-hover:text-brand-700 transition-colors mb-3 leading-tight">
                    {guide.title}
                  </h2>

                  {guide.summary && (
                    <p class="text-sm text-ink-muted line-clamp-2 mb-6 text-pretty">{guide.summary}</p>
                  )}

                  <div class="flex items-center justify-between pt-4 border-t border-surface">
                    <div class="flex items-center gap-4 text-xs text-ink-muted font-medium">
                      {productCount > 0 && (
                        <span>{productCount} product{productCount !== 1 ? 's' : ''}</span>
                      )}
                      {publishDate && (
                        <span>{publishDate}</span>
                      )}
                      {guide.author && (
                        <span>By {guide.author}</span>
                      )}
                    </div>
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-surface text-brand-700 group-hover:bg-brand-600 group-hover:text-white transition-colors duration-300">
                      <ArrowUpRight class="w-5 h-5" />
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-surface py-12 sm:py-16 border-t border-ink/5 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 sm:gap-6">
      <Logo width={140} height={34} />
      <p class="text-ink-muted text-xs sm:text-sm font-medium text-center sm:text-left">
        &copy; {new Date().getFullYear()} PawLabs. Affiliate Disclosure: We may earn commissions.
      </p>
    </div>
  </footer>

  <!-- Mobile Nav Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('hamburger-btn');
      const overlay = document.getElementById('mobile-overlay');
      const drawer = document.getElementById('mobile-drawer');
      const closeBtn = document.getElementById('drawer-close');
      if (!btn || !overlay || !drawer) return;
      function openDrawer() {
        overlay.classList.add('open');
        drawer.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
      function closeDrawer() {
        overlay.classList.remove('open');
        drawer.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
      btn.addEventListener('click', openDrawer);
      overlay.addEventListener('click', closeDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    });
  </script>
</Layout>
